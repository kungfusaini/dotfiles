#!/usr/bin/env bash
set -euo pipefail

workspace="comms"
hyprctl dispatch workspace "name:${workspace}" >/dev/null 2>&1 || true

node <<'NODE'
const { execFileSync, spawn } = require("node:child_process");

const workspace = "comms";
const apps = [
  { name: "WhatsApp", re: /^com\.rtosta\.zapzap$/,       cmd: `${process.env.HOME}/.config/hypr/scripts/zapzap-whatsapp` },
  { name: "Slack",    re: /^(slack|Slack)$/,             cmd: "slack" },
  { name: "Mail",     re: /^(thunderbird|Thunderbird)$/, cmd: "thunderbird" },
  { name: "Teams",    re: /^teams-for-linux$/i,          cmd: "teams-for-linux" },
];

function hypr(args) {
  try {
    return execFileSync("hyprctl", args, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    });
  } catch (_) {
    return "";
  }
}

function dispatch(...args) {
  hypr(["dispatch", ...args]);
}

function sleep(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

function clients() {
  try { return JSON.parse(hypr(["clients", "-j"]) || "[]"); }
  catch (_) { return []; }
}

function findApps() {
  const all = clients();
  return apps.map(app => ({
    app,
    client: all.find(c => app.re.test(String(c.class || ""))) || null,
  }));
}

function launch(command) {
  const child = spawn("sh", ["-c", `${command} >/dev/null 2>&1`], {
    detached: true,
    stdio: "ignore",
  });
  child.unref();
}

function sameGroup(items) {
  if (items.some(item => !item.client)) return false;
  const addresses = items.map(item => item.client.address);
  return items.every(({ client }) =>
    Array.isArray(client.grouped) &&
    addresses.every(address => client.grouped.includes(address))
  );
}

function groupContains(address, memberAddress) {
  const client = clients().find(c => c.address === address);
  return !!client?.grouped?.includes(memberAddress);
}

// Open only missing applications. Existing applications are never reopened.
for (const { app, client } of findApps()) {
  if (!client) launch(app.cmd);
}

// Wait for missing applications to create their windows.
for (let attempt = 0; attempt < 32; attempt++) {
  if (findApps().every(item => item.client)) break;
  sleep(250);
}

// Collect existing comms windows if one somehow ended up on another workspace.
for (const { client } of findApps()) {
  if (client?.address && client.workspace?.name !== workspace) {
    dispatch("focuswindow", `address:${client.address}`);
    dispatch("movetoworkspacesilent", `name:${workspace}`);
  }
}

dispatch("workspace", `name:${workspace}`);
sleep(100);

let found = findApps().filter(item => item.client);
if (found.length === 0) process.exit(0);

// Normal Super+C path: preserve the active tab, but keep the group itself
// tiled so ordinary auxiliary windows can appear beside it instead of behind it.
if (sameGroup(found) && found.length === apps.length) {
  dispatch("settiled", `address:${found[0].client.address}`);
  process.exit(0);
}

// Reuse the largest existing comms group. Never dismantle or rebuild it.
let anchor = found
  .filter(({ client }) => Array.isArray(client.grouped) && client.grouped.length > 0)
  .sort((a, b) => b.client.grouped.length - a.client.grouped.length)[0];

// If no group exists yet, create one from the first available comms window.
if (!anchor) {
  anchor = found[0];
  dispatch("focuswindow", `address:${anchor.client.address}`);
  dispatch("togglegroup");
  sleep(100);
}

const anchorAddress = anchor.client.address;

// Unlock deterministically. "disable" means disable the active-group lock.
dispatch("focuswindow", `address:${anchorAddress}`);
dispatch("lockactivegroup", "disable");

// Add only windows which are not already members of the existing group.
found = findApps().filter(item => item.client);
for (let index = 0; index < found.length; index++) {
  const item = found[index];
  const address = item.client.address;
  if (groupContains(address, anchorAddress)) continue;

  // Focus the desired predecessor so insertion follows the Waybar tab order.
  for (let offset = 1; offset <= found.length; offset++) {
    const predecessor = found[(index - offset + found.length) % found.length].client;
    if (groupContains(predecessor.address, anchorAddress)) {
      dispatch("focuswindow", `address:${predecessor.address}`);
      dispatch("lockactivegroup", "disable");
      break;
    }
  }

  dispatch("focuswindow", `address:${address}`);
  for (const direction of ["l", "r", "u", "d"]) {
    dispatch("moveintogroup", direction);
    sleep(100);
    if (groupContains(address, anchorAddress)) break;
  }
}

// Keep the completed tab group as one tiled layout node. Only its active member
// is shown; auxiliary windows remain separate tiles beside the group.
dispatch("focuswindow", `address:${anchorAddress}`);
dispatch("lockactivegroup", "enable");
dispatch("settiled", `address:${anchorAddress}`);
const whatsapp = findApps()[0]?.client;
if (whatsapp?.address) {
  dispatch("focuswindow", `address:${whatsapp.address}`);
}
NODE
