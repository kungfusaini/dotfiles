#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

project_id="11111111-1111-4111-8111-111111111111"
mkdir -p "$tmp/data/projects/$project_id" "$tmp/main" "$tmp/bin"
printf '# Isolated project instructions\n' >"$tmp/data/projects/$project_id/AGENTS.md"
cat >"$tmp/data/projects.json" <<EOF
{
  "version": 1,
  "projects": [{
    "id": "$project_id",
    "name": "Isolated Demo",
    "mainDirectory": "$tmp/main",
    "archivedAt": null
  }]
}
EOF

cat >"$tmp/bin/kitty" <<'PY'
#!/usr/bin/env python3
import json, os, sys
print(json.dumps({
    "argv": sys.argv[1:],
    "project": os.environ.get("PROJECT_OBJECT_NAME"),
    "projectHome": os.environ.get("PROJECT_OBJECT_HOME"),
    "sessionDir": os.environ.get("PI_CODING_AGENT_SESSION_DIR"),
}, indent=2))
PY
chmod +x "$tmp/bin/kitty"

export PROJECT_OBJECT_DATA_DIR="$tmp/data"
export PROJECT_OBJECT_STATE_DIR="$tmp/state"
export PROJECT_PICKER_KITTY="$tmp/bin/kitty"

printf '%s\n' '--- project-terminal environment (fake Kitty, isolated XDG roots) ---'
"$root/bin/project-terminal" --project-id "$project_id" -e pi

printf '%s\n' '--- Pi extension resolution and AGENTS.md read ---'
PROJECT_OBJECT_ID="$project_id" node --no-warnings --experimental-strip-types --input-type=module - <<EOF
import { resolveProject, readAgentInstructions } from "file://$root/integrations/pi/project-object.ts";
const resolution = resolveProject();
if (!resolution.project) throw new Error(resolution.error || "project not resolved");
console.log(JSON.stringify({
  project: resolution.project.name,
  projectHome: resolution.project.projectHome,
  instructions: readAgentInstructions(resolution.project),
}, null, 2));
EOF

printf '%s\n' 'Isolated demo passed; no live compositor, workspace, keyboard, or user XDG data was accessed.'
