#!/usr/bin/env python3

import json
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from project_object import (  # noqa: E402
    RegistryError,
    ensure_private_directory,
    find_project,
    project_browser_workspace_name,
    project_home,
    project_session_directory,
    read_registry,
    read_stream_registry,
    find_stream,
    stream_home,
    stream_session_directory,
    stream_workspace_name,
    verify_worktree_checkout,
)

HOME = Path.home()
DATA_ROOT = Path(os.environ.get("PROJECT_OBJECT_DATA_DIR", Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "project-object"))
STATE_ROOT = Path(os.environ.get("PROJECT_OBJECT_STATE_DIR", Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "project-object"))
REGISTRY_PATH = DATA_ROOT / "projects.json"
KITTY = os.environ.get("PROJECT_PICKER_KITTY", "kitty")
HYPRCTL = os.environ.get("PROJECT_PICKER_HYPRCTL", "hyprctl")
GIT = os.environ.get("PROJECT_OBJECT_GIT", "git")


def active_workspace_name():
    result = subprocess.run([HYPRCTL, "activeworkspace", "-j"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)
    if result.returncode != 0:
        return None
    try:
        return str(json.loads(result.stdout).get("name", ""))
    except json.JSONDecodeError:
        return None


def resolve_scope(project_id, stream_id, workspace=None):
    try:
        registry, _changed = read_registry(REGISTRY_PATH, DATA_ROOT)
        if project_id:
            project = find_project(registry, project_id=project_id)
            if not project:
                return None, None
            if not stream_id:
                return project, None
            stream = find_stream(read_stream_registry(DATA_ROOT, project), stream_id=stream_id)
            return project, stream

        workspace = workspace if workspace is not None else active_workspace_name()
        matches = []
        for candidate in registry["projects"]:
            if candidate.get("archivedAt"):
                continue
            if candidate["name"] == workspace or project_browser_workspace_name(candidate["name"]) == workspace:
                matches.append((candidate, None))
            streams = read_stream_registry(DATA_ROOT, candidate)
            for stream in streams["streams"]:
                if not stream.get("archivedAt") and stream_workspace_name(candidate["name"], stream["name"]) == workspace:
                    matches.append((candidate, stream))
        if len(matches) > 1:
            raise RegistryError(f"Ambiguous project or stream workspace name: {workspace!r}")
        return matches[0] if matches else (None, None)
    except RegistryError as error:
        if project_id or stream_id:
            raise
        print(f"project-terminal: ignoring invalid registry: {error}", file=sys.stderr)
        return None, None


def has_directory_argument(arguments):
    return any(argument in ("-d", "--directory", "--working-directory") or argument.startswith("--directory=") or argument.startswith("--working-directory=") for argument in arguments)


def main():
    arguments = sys.argv[1:]
    requested_project_id = None
    requested_stream_id = None
    while len(arguments) >= 1 and arguments[0] in ("--project-id", "--stream-id"):
        option = arguments[0]
        if len(arguments) < 2:
            raise SystemExit(f"project-terminal: {option} requires a UUID")
        if option == "--project-id":
            requested_project_id = arguments[1]
        else:
            requested_stream_id = arguments[1]
        arguments = arguments[2:]
    if requested_stream_id and not requested_project_id:
        raise SystemExit("project-terminal: --stream-id requires --project-id")

    launch_workspace = active_workspace_name()
    try:
        project, stream = resolve_scope(requested_project_id, requested_stream_id, launch_workspace)
    except RegistryError as error:
        raise SystemExit(f"project-terminal: {error}") from error
    if requested_project_id and not project:
        raise SystemExit(f"project-terminal: active project not found: {requested_project_id}")
    if requested_stream_id and not stream:
        raise SystemExit(f"project-terminal: active stream not found: {requested_stream_id}")

    environment = os.environ.copy()
    kitty_arguments = [KITTY]

    if not project:
        for variable in (
            "PROJECT_OBJECT_ID",
            "PROJECT_OBJECT_NAME",
            "PROJECT_OBJECT_HOME",
            "PROJECT_OBJECT_MAIN_DIRECTORY",
            "PROJECT_OBJECT_STREAM_ID",
            "PROJECT_OBJECT_STREAM_NAME",
            "PROJECT_OBJECT_STREAM_HOME",
            "PROJECT_OBJECT_WORKSPACE_NAME",
            "PI_CODING_AGENT_SESSION_DIR",
        ):
            environment.pop(variable, None)

    if project:
        project_id = project["id"]
        home = project_home(DATA_ROOT, project_id)
        working_directory = project["mainDirectory"]
        session_directory = project_session_directory(STATE_ROOT, project_id)
        directories = [DATA_ROOT, DATA_ROOT / "projects", home, STATE_ROOT, STATE_ROOT / "projects", STATE_ROOT / "projects" / project_id]
        if stream:
            stream_id = stream["id"]
            stream_data_home = stream_home(DATA_ROOT, project_id, stream_id)
            session_directory = stream_session_directory(STATE_ROOT, project_id, stream_id)
            working_directory = stream.get("mainDirectory") or working_directory
            if stream.get("worktree"):
                try:
                    verify_worktree_checkout(stream["worktree"], GIT)
                except RegistryError as error:
                    raise SystemExit(f"project-terminal: stream worktree is not safely prepared; open the stream through the project picker: {error}") from error
            directories.extend([
                home / "streams",
                stream_data_home,
                STATE_ROOT / "projects" / project_id / "streams",
                STATE_ROOT / "projects" / project_id / "streams" / stream_id,
            ])
            environment.update({
                "PROJECT_OBJECT_STREAM_ID": stream_id,
                "PROJECT_OBJECT_STREAM_NAME": stream["name"],
                "PROJECT_OBJECT_STREAM_HOME": str(stream_data_home),
            })
        else:
            for variable in ("PROJECT_OBJECT_STREAM_ID", "PROJECT_OBJECT_STREAM_NAME", "PROJECT_OBJECT_STREAM_HOME"):
                environment.pop(variable, None)
        directories.append(session_directory)
        for directory in directories:
            ensure_private_directory(directory)

        workspace = stream_workspace_name(project["name"], stream["name"]) if stream else project["name"]
        if not requested_project_id and launch_workspace:
            workspace = launch_workspace
        environment.update({
            "PROJECT_OBJECT_ID": project_id,
            "PROJECT_OBJECT_NAME": project["name"],
            "PROJECT_OBJECT_HOME": str(home),
            "PROJECT_OBJECT_MAIN_DIRECTORY": working_directory,
            "PROJECT_OBJECT_WORKSPACE_NAME": workspace,
            "PI_CODING_AGENT_SESSION_DIR": str(session_directory),
        })
        if not has_directory_argument(arguments):
            kitty_arguments.extend(["--directory", working_directory])
        # Project Object already asks for confirmation and snapshots the workspace.
        # Suppress Kitty's redundant active-process prompt only for these terminals.
        kitty_arguments.extend(["--override", "confirm_os_window_close=0"])

    kitty_arguments.extend(arguments)
    os.execvpe(KITTY, kitty_arguments, environment)


if __name__ == "__main__":
    main()
