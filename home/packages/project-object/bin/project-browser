#!/usr/bin/env python3

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from project_object import (  # noqa: E402
    RegistryError,
    ensure_private_directory,
    find_project,
    project_browser_workspace_name,
    read_registry,
    read_stream_registry,
    stream_workspace_name,
    write_json_atomic,
)

HOME = Path.home()
DATA_ROOT = Path(os.environ.get("PROJECT_OBJECT_DATA_DIR", Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "project-object"))
RUNTIME_ROOT = Path(os.environ.get("PROJECT_OBJECT_RUNTIME_DIR", Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/project-object-{os.getuid()}")) / "project-object"))
REGISTRY_PATH = DATA_ROOT / "projects.json"
STATE_PATH = RUNTIME_ROOT / "browser-windows.json"
LOCK_PATH = RUNTIME_ROOT / "browser.lock"
CLICK_MODE_ROOT = RUNTIME_ROOT / "browser-click-modes"
HYPRCTL = os.environ.get("PROJECT_BROWSER_HYPRCTL", "hyprctl")
VIVALDI = os.environ.get("PROJECT_BROWSER_VIVALDI", "vivaldi")
NOTIFY = os.environ.get("PROJECT_BROWSER_NOTIFY", "notify-send")
GLOBAL_WORKSPACE = "browser"
BROWSER_CLASSES = ("vivaldi", "vivaldi-stable")
ADDRESS_PATTERN = re.compile(r"0x[0-9a-fA-F]+")
CLICK_MODE_TTL = 1.0
LAUNCH_WORKSPACE_ENV = "PROJECT_OBJECT_LAUNCH_WORKSPACE_NAME"


def notify_error(message: str) -> None:
    subprocess.run([NOTIFY, "Project browser", message], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def run(command: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)


def hypr_json(command: str):
    result = run([HYPRCTL, command, "-j"])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"hyprctl {command} failed")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"hyprctl {command} returned invalid JSON") from error


def dispatch(name: str, argument: str) -> None:
    result = run([HYPRCTL, "dispatch", name, argument])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"Hyprland dispatch {name} failed")


def active_workspace_name() -> str:
    workspace = hypr_json("activeworkspace")
    if not isinstance(workspace, dict):
        raise RuntimeError("hyprctl activeworkspace did not return an object")
    return str(workspace.get("name", ""))


def invoking_workspace_name() -> str:
    explicit = os.environ.get(LAUNCH_WORKSPACE_ENV, "")
    return explicit if explicit else active_workspace_name()


def active_window_address() -> str | None:
    window = hypr_json("activewindow")
    if not isinstance(window, dict):
        return None
    address = str(window.get("address", ""))
    return address if ADDRESS_PATTERN.fullmatch(address) else None


def clients() -> list[dict]:
    value = hypr_json("clients")
    if not isinstance(value, list):
        raise RuntimeError("hyprctl clients did not return a list")
    return [client for client in value if isinstance(client, dict)]


def is_browser(client: dict) -> bool:
    classes = (str(client.get("class", "")).lower(), str(client.get("initialClass", "")).lower())
    return any(any(value.startswith(prefix) for prefix in BROWSER_CLASSES) for value in classes)


def client_address(client: dict) -> str | None:
    address = str(client.get("address", ""))
    return address if ADDRESS_PATTERN.fullmatch(address) else None


def client_workspace(client: dict) -> str:
    workspace = client.get("workspace")
    return str(workspace.get("name", "")) if isinstance(workspace, dict) else ""


def browser_clients(*, workspace: str | None = None) -> list[dict]:
    return [client for client in clients() if is_browser(client) and (workspace is None or client_workspace(client) == workspace)]


def load_registry() -> dict:
    registry, _changed = read_registry(REGISTRY_PATH, DATA_ROOT)
    return registry


def workspace_matches(registry: dict, workspace: str) -> list[dict]:
    matches: list[dict] = []
    for project in registry["projects"]:
        if project.get("archivedAt"):
            continue
        names = {project["name"], project_browser_workspace_name(project["name"])}
        streams = read_stream_registry(DATA_ROOT, project)
        names.update(
            stream_workspace_name(project["name"], stream["name"])
            for stream in streams["streams"]
            if not stream.get("archivedAt")
        )
        if workspace in names:
            matches.append(project)
    return matches


def resolve_project(registry: dict, workspace: str) -> dict | None:
    project_id = os.environ.get("PROJECT_OBJECT_ID")
    if project_id:
        project = find_project(registry, project_id=project_id)
        if project:
            return project
    matches = workspace_matches(registry, workspace)
    unique = {project["id"]: project for project in matches}
    if len(unique) > 1:
        raise RegistryError(f"Ambiguous project workspace: {workspace!r}")
    return next(iter(unique.values()), None)


def workspace_belongs_to_project(registry: dict, workspace: str, project: dict) -> bool:
    return any(candidate["id"] == project["id"] for candidate in workspace_matches(registry, workspace))


def validate_browser_role(registry: dict, project: dict) -> str:
    role = project_browser_workspace_name(project["name"])
    conflicts: list[str] = []
    for candidate in registry["projects"]:
        if candidate.get("archivedAt"):
            continue
        if candidate["id"] != project["id"] and candidate["name"] == role:
            conflicts.append(candidate["name"])
        streams = read_stream_registry(DATA_ROOT, candidate)
        for stream in streams["streams"]:
            if not stream.get("archivedAt") and stream_workspace_name(candidate["name"], stream["name"]) == role:
                conflicts.append(f"{candidate['name']} / {stream['name']}")
    if conflicts:
        raise RuntimeError(f"Browser workspace {role!r} conflicts with an existing project or stream")
    return role


def empty_state() -> dict:
    return {"version": 1, "primary": {}, "companions": {}, "returns": {}}


def load_state() -> dict:
    if not STATE_PATH.exists():
        return empty_state()
    if STATE_PATH.is_symlink():
        raise RuntimeError(f"Unsafe browser state file: {STATE_PATH}")
    try:
        value = json.loads(STATE_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return empty_state()
    if not isinstance(value, dict) or value.get("version") != 1:
        return empty_state()
    if not isinstance(value.get("primary"), dict) or not isinstance(value.get("companions"), dict):
        return empty_state()
    if not isinstance(value.get("returns"), dict):
        value["returns"] = {}
    return value


def save_state(state: dict) -> None:
    write_json_atomic(STATE_PATH, state)


@contextmanager
def browser_lock():
    ensure_private_directory(RUNTIME_ROOT)
    descriptor = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def live_address(address: object, workspace: str) -> str | None:
    if not isinstance(address, str) or not ADDRESS_PATTERN.fullmatch(address):
        return None
    for client in browser_clients(workspace=workspace):
        if client_address(client) == address:
            return address
    return None


def discover_address(workspace: str, preferred: object = None) -> str | None:
    address = live_address(preferred, workspace)
    if address:
        return address
    candidates = [client_address(client) for client in browser_clients(workspace=workspace)]
    return next((candidate for candidate in candidates if candidate), None)


def focus_address(address: str) -> None:
    dispatch("focuswindow", f"address:{address}")


def vivaldi_command(urls: list[str], *, new_window: bool = False) -> list[str]:
    command = [VIVALDI]
    if new_window:
        command.append("--new-window")
    if urls:
        command.append("--")
        command.extend(urls)
    return command


def launch_urls(urls: list[str], *, new_window: bool = False) -> None:
    subprocess.Popen(
        vivaldi_command(urls, new_window=new_window),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def launch_new_browser(workspace: str, urls: list[str], *, beside_active: bool = False) -> str:
    before = {client_address(client) for client in browser_clients()}
    if beside_active:
        result = run([HYPRCTL, "dispatch", "layoutmsg", "preselect r"])
        if result.returncode != 0:
            # Placement is best effort; opening the browser is still useful.
            pass
    launch_urls(urls, new_window=True)
    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        for client in browser_clients():
            address = client_address(client)
            if address and address not in before:
                current_workspace = client_workspace(client)
                if current_workspace != workspace:
                    dispatch("movetoworkspacesilent", f"name:{workspace},address:{address}")
                return address
        time.sleep(0.05)
    raise RuntimeError("Vivaldi did not create a browser window")


def open_in_window(address: str, urls: list[str]) -> None:
    focus_address(address)
    if urls:
        time.sleep(0.05)
        launch_urls(urls)


def ensure_global_browser(urls: list[str], *, focus_only: bool = False) -> None:
    dispatch("workspace", f"name:{GLOBAL_WORKSPACE}")
    address = discover_address(GLOBAL_WORKSPACE)
    if address:
        open_in_window(address, [] if focus_only else urls)
    else:
        launch_new_browser(GLOBAL_WORKSPACE, [] if focus_only else urls)


def ensure_project_browser(
    registry: dict,
    project: dict,
    urls: list[str],
    state: dict,
    *,
    focus_only: bool = False,
    origin_workspace: str | None = None,
) -> None:
    workspace = validate_browser_role(registry, project)
    if (
        origin_workspace
        and origin_workspace != workspace
        and workspace_belongs_to_project(registry, origin_workspace, project)
    ):
        state["returns"][project["id"]] = origin_workspace
        save_state(state)
    dispatch("workspace", f"name:{workspace}")
    primary = state["primary"].get(project["id"])
    address = discover_address(workspace, primary)
    if address:
        open_in_window(address, [] if focus_only else urls)
    else:
        address = launch_new_browser(workspace, [] if focus_only else urls)
    state["primary"][project["id"]] = address
    save_state(state)


def ensure_companion_browser(project: dict, workspace: str, urls: list[str], state: dict) -> None:
    project_companions = state["companions"].setdefault(project["id"], {})
    address = discover_address(workspace, project_companions.get(workspace))
    if address:
        open_in_window(address, urls)
    else:
        terminal_address = active_window_address()
        if terminal_address:
            focus_address(terminal_address)
        address = launch_new_browser(workspace, urls, beside_active=True)
    project_companions[workspace] = address
    save_state(state)


def click_marker_path() -> Path:
    # Kitty's background launch action does not add KITTY_WINDOW_ID. Both the
    # marker and URL opener are direct children of the same Kitty OS process,
    # however, so its PID is a stable per-terminal fallback for this one-shot
    # handoff. Older Kitty processes can already carry KITTY_WINDOW_ID.
    kitty_window_id = os.environ.get("KITTY_WINDOW_ID", "")
    key = kitty_window_id if re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", kitty_window_id) else f"pid-{os.getppid()}"
    return CLICK_MODE_ROOT / key


def mark_project_click() -> None:
    marker = click_marker_path()
    ensure_private_directory(CLICK_MODE_ROOT)
    write_json_atomic(marker, {"mode": "project", "created": time.time()})


def consume_click_mode(default: str) -> str:
    marker = click_marker_path()
    if not marker.exists() or marker.is_symlink():
        return default
    try:
        value = json.loads(marker.read_text())
    except (OSError, json.JSONDecodeError):
        value = {}
    finally:
        marker.unlink(missing_ok=True)
    created = value.get("created")
    if value.get("mode") == "project" and isinstance(created, (int, float)) and 0 <= time.time() - created <= CLICK_MODE_TTL:
        return "project"
    return default


def validate_urls(urls: list[str]) -> list[str]:
    result = []
    for url in urls:
        parsed = urlsplit(url)
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            raise ValueError(f"Unsupported browser URL: {url!r}")
        result.append(url)
    return result


def live_workspace_names() -> set[str]:
    value = hypr_json("workspaces")
    if not isinstance(value, list):
        raise RuntimeError("hyprctl workspaces did not return a list")
    return {
        str(workspace.get("name", ""))
        for workspace in value
        if isinstance(workspace, dict)
    }


def return_from_project_browser(registry: dict, project: dict, state: dict) -> bool:
    target = state["returns"].get(project["id"])
    live = live_workspace_names()
    if (
        isinstance(target, str)
        and target != project_browser_workspace_name(project["name"])
        and target in live
        and workspace_belongs_to_project(registry, target, project)
    ):
        dispatch("workspace", f"name:{target}")
        return True
    state["returns"].pop(project["id"], None)
    save_state(state)
    return False


def open_urls(mode: str, urls: list[str]) -> None:
    urls = validate_urls(urls)
    workspace = invoking_workspace_name()
    registry = load_registry()
    project = resolve_project(registry, workspace)
    if not project:
        ensure_global_browser(urls)
        return
    if mode == "adjacent" and not workspace_belongs_to_project(registry, workspace, project):
        mode = "project"
    with browser_lock():
        state = load_state()
        if mode == "project" or workspace == project_browser_workspace_name(project["name"]):
            ensure_project_browser(registry, project, urls, state, origin_workspace=workspace)
        else:
            ensure_companion_browser(project, workspace, urls, state)


def focus_browser() -> None:
    workspace = active_workspace_name()
    registry = load_registry()
    project = resolve_project(registry, workspace)
    with browser_lock():
        if project:
            state = load_state()
            role = project_browser_workspace_name(project["name"])
            if workspace == role and return_from_project_browser(registry, project, state):
                return
            ensure_project_browser(
                registry,
                project,
                [],
                state,
                focus_only=True,
                origin_workspace=workspace,
            )
        else:
            ensure_global_browser([], focus_only=True)


def parse_args(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Open browser windows in the active Project Object context")
    commands = parser.add_subparsers(dest="command", required=True)
    opener = commands.add_parser("open")
    opener.add_argument("--mode", choices=("adjacent", "project"), default="adjacent")
    opener.add_argument("urls", nargs="+")
    commands.add_parser("mark-project-click")
    commands.add_parser("focus")
    return parser.parse_args(arguments)


def main() -> int:
    args = parse_args(sys.argv[1:])
    try:
        if args.command == "mark-project-click":
            mark_project_click()
        elif args.command == "focus":
            focus_browser()
        else:
            open_urls(consume_click_mode(args.mode), args.urls)
        return 0
    except (OSError, RegistryError, RuntimeError, ValueError) as error:
        message = str(error)
        print(f"project-browser: {message}", file=sys.stderr)
        notify_error(message)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
