#!/usr/bin/env python3

import json
import os
from pathlib import Path
import subprocess

GUI = Path(__file__).resolve().with_name("project-picker-gui")
HYPRCTL = os.environ.get("PROJECT_PICKER_HYPRCTL", "hyprctl")
PICKER_CLASSES = {"dev.project_object.Picker", "project-picker"}


def focus_existing_picker():
    result = subprocess.run(
        [HYPRCTL, "clients", "-j"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        return False
    try:
        clients = json.loads(result.stdout)
    except json.JSONDecodeError:
        return False
    for client in clients:
        classes = {str(client.get("class", "")), str(client.get("initialClass", ""))}
        if classes & PICKER_CLASSES and client.get("address"):
            subprocess.run(
                [HYPRCTL, "dispatch", "focuswindow", f"address:{client['address']}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            return True
    return False


if not focus_existing_picker():
    os.execv(str(GUI), [str(GUI)])
