#!/usr/bin/env python3

import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

HOME = Path.home()
RUNTIME_ROOT = Path(os.environ.get("PROJECT_OBJECT_RUNTIME_DIR", Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/project-object-{os.getuid()}")) / "project-object"))
PID_PATH = RUNTIME_ROOT / "picker-gui.json"
START_LOCK_PATH = RUNTIME_ROOT / "picker-start.lock"
GUI = Path(__file__).resolve().with_name("project-picker-gui")
PACKAGED_GUI_SOURCE = GUI.with_name(".project-picker-gui-wrapped")
HYPRCTL = os.environ.get("PROJECT_PICKER_HYPRCTL", "hyprctl")
PICKER_CLASSES = {"dev.project_object.Picker", "project-picker"}


def dismiss_existing_picker(pid):
    result = subprocess.run([HYPRCTL, "clients", "-j"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)
    if result.returncode != 0:
        return False
    try:
        clients = json.loads(result.stdout)
    except json.JSONDecodeError:
        return False
    for client in clients:
        classes = {str(client.get("class", "")), str(client.get("initialClass", ""))}
        if classes & PICKER_CLASSES and client.get("pid") == pid and client.get("address"):
            dismissed = subprocess.run(
                [HYPRCTL, "dispatch", "closewindow", f"address:{client['address']}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            return dismissed.returncode == 0
    return False


def running_daemon():
    try:
        record = json.loads(PID_PATH.read_text())
        pid = int(record["pid"])
        command = Path(record["command"])
        os.kill(pid, 0)
        if command not in (GUI, PACKAGED_GUI_SOURCE):
            os.kill(pid, signal.SIGTERM)
            return None
        return pid
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
        PID_PATH.unlink(missing_ok=True)
        return None


def wait_for_daemon(process, timeout=10):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError("The project picker daemon exited during startup")
        try:
            record = json.loads(PID_PATH.read_text())
            if int(record["pid"]) == process.pid and Path(record["command"]) in (GUI, PACKAGED_GUI_SOURCE):
                return
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            pass
        time.sleep(0.01)
    process.terminate()
    raise RuntimeError("The project picker daemon did not become ready")


def start_daemon(show, close_active_workspace=False, next_attention=False, previous_attention=False):
    arguments = [str(GUI), "--daemon"]
    if show:
        arguments.append("--show")
    if close_active_workspace:
        arguments.append("--close-active-workspace")
    if next_attention:
        arguments.append("--next-attention")
    if previous_attention:
        arguments.append("--previous-attention")
    process = subprocess.Popen(
        arguments,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    wait_for_daemon(process)


def main():
    preload = "--preload" in sys.argv[1:]
    next_attention = "--next-attention" in sys.argv[1:]
    previous_attention = "--previous-attention" in sys.argv[1:]
    close_active_workspace = "--close-active-workspace" in sys.argv[1:]
    RUNTIME_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    RUNTIME_ROOT.chmod(0o700)
    lock_fd = os.open(START_LOCK_PATH, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(lock_fd, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        pid = running_daemon()
        if pid:
            if previous_attention:
                os.kill(pid, signal.SIGINT)
            elif next_attention:
                os.kill(pid, signal.SIGHUP)
            elif close_active_workspace:
                os.kill(pid, signal.SIGUSR2)
            elif not preload and not dismiss_existing_picker(pid):
                os.kill(pid, signal.SIGUSR1)
            return
        if previous_attention:
            start_daemon(show=False, previous_attention=True)
        elif next_attention:
            start_daemon(show=False, next_attention=True)
        else:
            start_daemon(show=not preload and not close_active_workspace, close_active_workspace=close_active_workspace)
    finally:
        os.close(lock_fd)


if __name__ == "__main__":
    main()
