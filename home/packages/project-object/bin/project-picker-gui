.create-entry { min-height: 42px; border-radius: 10px; }
.primary-button { background: #7c9cff; color: #0d1020; font-weight: 750; border-radius: 10px; min-height: 40px; }
.secondary-button { border-radius: 10px; min-height: 40px; }
.error { color: #ff8f9b; font-size: 12px; }
