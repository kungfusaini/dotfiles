def working_spinner():
    spinner = Gtk.Spinner()
    spinner.add_css_class("agent-spinner")
    spinner.set_size_request(12, 12)
    spinner.set_valign(Gtk.Align.CENTER)
    spinner.set_tooltip_text("Agent working")
    spinner.start()
    return spinner


def workspace_indicator(state, working):
    if working and state != "closed":
        indicator = working_spinner()
        indicator.set_size_request(20, 12)
        return indicator
    dot = Gtk.Label(label="●" if state != "closed" else "○")
    dot.add_css_class("project-dot")
    return dot


class ProjectRow(Gtk.ListBoxRow):
    def __init__(self, project, expanded=False, agent_states=(), errors=()):
        super().__init__()
        self.project = project
        self.render_key = (type(self), project, frozenset(agent_states), tuple(errors))
        self.add_css_class("project-row")

        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        content.add_css_class("row-content")
        arrow = Gtk.Label(label="▾" if expanded else "▸")
        arrow.add_css_class("project-arrow")
        content.append(arrow)
        self.arrow = arrow

        name = Gtk.Label(label=project["name"], xalign=0, ellipsize=3)
        name.add_css_class("project-name")
        name.set_hexpand(True)
        content.append(name)

        if "idle" in agent_states:
            agent = Gtk.Label(label="●")
            agent.add_css_class("agent-status")
            agent.add_css_class("agent-status-idle")
            agent.set_tooltip_text("Agent settled / waiting for attention")
            content.append(agent)
        if "working" in agent_states:
            content.append(working_spinner())

        if errors:
            warning = Gtk.Label(label=f"⚠ {len(errors)} stream error(s)")
            warning.add_css_class("stream-count")
            content.append(warning)
            self.set_tooltip_text("\n".join(errors))
        self.set_child(content)


class ProjectWorkspaceRow(Gtk.ListBoxRow):
    def __init__(self, project, state, working=False):
        super().__init__()
        self.project = project
        self.state = state
        self.render_key = (type(self), project, state, working)
        self.add_css_class("project-row")
        self.add_css_class("scope-row")
        self.add_css_class("project-workspace-row")
        if state != "closed":
            self.add_css_class("running-scope-row")
        if state == "current":
            self.add_css_class("active-workspace-row")

        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        content.add_css_class("row-content")
        name = Gtk.Label(label="Project workspace", xalign=0, ellipsize=3)
        name.add_css_class("project-name")
        name.set_hexpand(True)
        content.append(name)
        content.append(workspace_indicator(state, working))
        self.set_child(content)


class StreamRow(Gtk.ListBoxRow):
    def __init__(self, project, stream, state, working=False):
        super().__init__()
        self.project = project
        self.stream = stream
        self.state = state
        self.render_key = (type(self), project, stream, state, working)
        self.add_css_class("project-row")
        self.add_css_class("scope-row")
        self.add_css_class("stream-row")
        if state != "closed":
            self.add_css_class("running-scope-row")
        if state == "current":
            self.add_css_class("active-workspace-row")

        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        content.add_css_class("row-content")
        name = Gtk.Label(label=stream["name"], xalign=0, ellipsize=3)
        name.add_css_class("project-name")
        name.set_hexpand(True)
        content.append(name)
        content.append(workspace_indicator(state, working))
        self.set_child(content)


class StreamRegistryErrorRow(Gtk.ListBoxRow):
    """Display-only diagnostic: never carries a stream or executable scope."""
    def __init__(self, error):
        super().__init__()
        self.error = error
        self.render_key = (type(self), error)
        self.add_css_class("scope-row")
        label = Gtk.Label(label=f"⚠ {error}", xalign=0, ellipsize=3)
        label.add_css_class("error")
        label.add_css_class("row-content")
        self.set_tooltip_text(error)
        self.set_child(label)


class DirectorySuggestionRow(Gtk.ListBoxRow):
    def __init__(self, path):
        super().__init__()
        self.path = path
        self.add_css_class("directory-suggestion")
        display_path = path
        home = str(Path.home())
        if path == home:
            display_path = "~"
        elif path.startswith(home + os.sep):
            display_path = "~" + path[len(home):]
        label = Gtk.Label(label=display_path, xalign=0, ellipsize=3)
        label.add_css_class("directory-path")
        self.set_child(label)


class PickerApplication(Adw.Application):
    def __init__(self, persistent=False, start_hidden=False):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.persistent = persistent
        self.start_hidden = start_hidden
        self.window = None
        self.registry = None
        self.session = None
        self.rows = []
        self.agent_activity = {}
        self.context_cache = {}
        self.context_scope_targets = []
        self.context_open = False
        self.context_details_open = False
        self.context_refresh_pending = False
        self.expanded_project_ids = set()
        self.selected_scope = None
        self.selected_project = None
        self.stream_registry = None
        self.search_mode = False
        self.pending_g = False
        self.directory_candidates = []
        self.directory_candidates_loaded = False
        self.directory_candidates_loading = False
        self.directory_selected_path = None
        self.destructive_action_pending = False

    def do_startup(self):
        Adw.Application.do_startup(self)
        self.install_actions()
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        if self.window:
            if not self.start_hidden:
                self.show_window()
            return
        try:
            backend.ensure_directory(backend.DATA_ROOT)
            backend.ensure_directory(backend.DATA_ROOT / "projects")
            backend.ensure_directory(backend.RUNTIME_ROOT)
            self.registry = backend.load_registry()
            self.session = backend.reconcile_session(self.registry, backend.load_session())
            self.current_workspace = backend.active_workspace_name()
            self.agent_activity = self.load_agent_activity()
            self.load_picker_state()
            self.preload_context_cache()
        except Exception as error:
            backend.notify_error(str(error))
            self.quit()
            return
        self.build_window()
        if not self.start_hidden:
            self.show_window()

    def build_window(self):
        self.window = Adw.ApplicationWindow(application=self)
        self.window.set_title("Projects")
        initial_width = INSPECTOR_WIDTH if self.context_open else COMPACT_WIDTH
        self.window.set_default_size(initial_width, WINDOW_HEIGHT)
        self.window.set_size_request(initial_width, WINDOW_HEIGHT)
        self.window.set_decorated(False)
        self.window.connect("close-request", self.on_close_request)

        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        shell.add_css_class("picker-shell")
        handle = Gtk.WindowHandle()
        handle.set_child(shell)
        self.window.set_content(handle)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=140)
        shell.append(self.stack)
        self.stack.add_named(self.build_list_page(), "list")
        self.stack.add_named(self.build_create_page(), "create")
        self.stack.add_named(self.build_create_stream_page(), "create-stream")

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key_pressed)
        self.window.add_controller(keys)
        GLib.timeout_add_seconds(1, self.poll_activity)
        GLib.timeout_add_seconds(2, self.poll_context)

    def build_list_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header.add_css_class("header")
        self.list_title = Gtk.Label(label="Projects", xalign=0)
        self.list_title.add_css_class("title")
        self.list_title.set_hexpand(True)
        shortcut = Gtk.Label(label="SUPER  P")
        shortcut.add_css_class("shortcut")
        header.append(self.list_title)
        header.append(shortcut)
        page.append(header)

        self.search = Gtk.SearchEntry(placeholder_text="Press / to search projects and streams…")
        self.search.add_css_class("search")
        self.search.connect("search-changed", lambda _entry: self.refresh_rows())
        self.search.connect("activate", lambda _entry: self.open_selected())
        page.append(self.search)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, vexpand=True)
        self.list_scroll = Gtk.ScrolledWindow(vexpand=True, hexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False)
        self.listbox.add_css_class("project-list")
        self.listbox.connect("row-selected", self.on_row_selected)
        self.listbox.connect("row-activated", lambda _box, _row: self.open_selected())
        self.list_scroll.set_child(self.listbox)
        body.append(self.list_scroll)

        self.context_separator = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        self.context_separator.add_css_class("context-separator")
        self.context_separator.set_visible(self.context_open)
        body.append(self.context_separator)
        self.context_inspector = self.build_context_inspector()
        self.context_inspector.set_visible(self.context_open)
        body.append(self.context_inspector)
        page.append(body)

        footer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        footer.add_css_class("footer")
        self.footer_hint = Gtk.Label(label=FOOTER_HINT, xalign=0, ellipsize=3)
        self.footer_hint.add_css_class("footer-key")
        footer.append(self.footer_hint)
        create_hint = Gtk.Label(label=CREATE_FOOTER_HINT, xalign=0)
        create_hint.add_css_class("footer-key")
        footer.append(create_hint)
        page.append(footer)
        self.refresh_rows()
        return page

    def build_context_inspector(self):
        scroll = Gtk.ScrolledWindow(vexpand=True, hexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_size_request(500, -1)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.add_css_class("context-inspector")

        kicker = Gtk.Label(label="SELECTED CONTEXT", xalign=0)
        kicker.add_css_class("context-kicker")
        content.append(kicker)
        self.context_title = Gtk.Label(xalign=0, ellipsize=3)
        self.context_title.add_css_class("context-title")
        content.append(self.context_title)

        status_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.context_status = Gtk.Label(xalign=0)
        self.context_status.add_css_class("context-status")
        self.context_status.set_hexpand(True)
        status_row.append(self.context_status)
        self.context_age = Gtk.Label(xalign=1)
        self.context_age.add_css_class("context-age")
        status_row.append(self.context_age)
        content.append(status_row)

        rule = Gtk.Separator()
        rule.add_css_class("context-rule")
        content.append(rule)

        def section(title):
            label = Gtk.Label(label=title, xalign=0)
            label.add_css_class("context-section")
            content.append(label)
            copy = Gtk.Label(xalign=0, wrap=True)
            copy.add_css_class("context-copy")
            content.append(copy)
            return copy

        self.context_current = section("CURRENT")

        next_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        next_box.add_css_class("context-next")
        next_label = Gtk.Label(label="NEXT", xalign=0)
        next_label.add_css_class("context-section")
        next_box.append(next_label)
        self.context_next = Gtk.Label(xalign=0, wrap=True)
        self.context_next.add_css_class("context-copy")
        next_box.append(self.context_next)
        content.append(next_box)

        self.context_details_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.context_details_box.set_visible(self.context_details_open)
        details_label = Gtk.Label(label="DETAILS", xalign=0)
        details_label.add_css_class("context-section")
        self.context_details_box.append(details_label)
        self.context_details = Gtk.Label(xalign=0, wrap=True)
        self.context_details.add_css_class("context-copy")
        self.context_details_box.append(self.context_details)
        self.context_source = Gtk.Label(xalign=0)
        self.context_source.add_css_class("context-source")
        self.context_details_box.append(self.context_source)
        content.append(self.context_details_box)
        content.append(Gtk.Box(vexpand=True))
        preview_rule = Gtk.Label(label="Selection only previews · Enter switches workspace", xalign=1)
        preview_rule.add_css_class("context-rule-copy")
        content.append(preview_rule)
        scroll.set_child(content)
        return scroll

    def build_create_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        page.add_css_class("create-page")
        title = Gtk.Label(label="New project", xalign=0)
        title.add_css_class("section-title")
        copy = Gtk.Label(label="Give it a name and choose the directory where the work lives.", xalign=0)
        copy.add_css_class("section-copy")
        page.append(title)
        page.append(copy)

        for label_text in ("PROJECT NAME",):
            label = Gtk.Label(label=label_text, xalign=0)
            label.add_css_class("field-label")
            page.append(label)
        self.name_entry = Gtk.Entry(placeholder_text="e.g. Elijah")
        self.name_entry.add_css_class("create-entry")
        self.name_entry.connect("activate", lambda _entry: self.directory_entry.grab_focus())
        page.append(self.name_entry)

        label = Gtk.Label(label="MAIN DIRECTORY", xalign=0)
        label.add_css_class("field-label")
        page.append(label)
        self.directory_entry = Gtk.Entry(placeholder_text="Type a path or fuzzy fragments…", hexpand=True)
        self.directory_entry.add_css_class("create-entry")
        self.directory_entry.connect("changed", self.on_directory_changed)
        self.directory_entry.connect("activate", lambda _entry: self.activate_directory_entry())
        directory_focus = Gtk.EventControllerFocus()
        directory_focus.connect("enter", lambda *_args: self.refresh_directory_suggestions())
        self.directory_entry.add_controller(directory_focus)
        page.append(self.directory_entry)

        self.directory_suggestions = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=True)
        self.directory_suggestions.add_css_class("directory-suggestions")
        self.directory_suggestions.connect("row-activated", lambda _box, row: self.select_directory_suggestion(row))
        self.directory_suggestions_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.directory_suggestions_scroll.set_max_content_height(170)
        self.directory_suggestions_scroll.set_propagate_natural_height(True)
        self.directory_suggestions_scroll.set_child(self.directory_suggestions)
        self.directory_suggestions_scroll.set_visible(False)
        page.append(self.directory_suggestions_scroll)

        self.directory_hint = Gtk.Label(label="Loading directories…", xalign=0)
        self.directory_hint.add_css_class("directory-hint")
        self.directory_hint.set_visible(False)
        page.append(self.directory_hint)

        self.create_error = Gtk.Label(xalign=0, wrap=True)
        self.create_error.add_css_class("error")
        self.create_error.set_visible(False)
        page.append(self.create_error)

        spacer = Gtk.Box(vexpand=True)
        page.append(spacer)
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.add_css_class("secondary-button")
        cancel.connect("clicked", lambda _button: self.show_list())
        self.create_button = Gtk.Button(label="Create project")
        self.create_button.add_css_class("primary-button")
        self.create_button.connect("clicked", lambda _button: self.create_project())
        actions.append(cancel)
        actions.append(self.create_button)
        page.append(actions)
        return page

    def build_create_stream_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        page.add_css_class("create-page")
        title = Gtk.Label(label="New stream", xalign=0)
        title.add_css_class("section-title")
        self.stream_create_copy = Gtk.Label(label="Create a focused scope inside this project.", xalign=0)
        self.stream_create_copy.add_css_class("section-copy")
        page.append(title)
        page.append(self.stream_create_copy)

        label = Gtk.Label(label="STREAM NAME", xalign=0)
        label.add_css_class("field-label")
        page.append(label)
        self.stream_name_entry = Gtk.Entry(placeholder_text="e.g. Forecast Bench")
        self.stream_name_entry.add_css_class("create-entry")
        self.stream_name_entry.connect("activate", lambda _entry: self.create_stream())
        page.append(self.stream_name_entry)

        repository_label = Gtk.Label(label="GIT REPOSITORY", xalign=0)
        repository_label.add_css_class("field-label")
        page.append(repository_label)
        self.stream_repository_entry = Gtk.Entry(placeholder_text="Auto-detect, or enter an absolute repository path")
        self.stream_repository_entry.add_css_class("create-entry")
        self.stream_repository_entry.connect("activate", lambda _entry: self.create_stream())
        page.append(self.stream_repository_entry)
        self.stream_repository_candidates = None
        self.pending_stream_id = None
        self.pending_stream_open_id = None

        self.stream_no_worktree = Gtk.CheckButton(label="This is a non-code stream; use the shared project directory")
        page.append(self.stream_no_worktree)
        isolation = Gtk.Label(label="Git-backed streams prepare an isolated shared worktree when first opened.", xalign=0, wrap=True)
        isolation.add_css_class("section-copy")
        page.append(isolation)

        self.stream_create_error = Gtk.Label(xalign=0, wrap=True)
        self.stream_create_error.add_css_class("error")
        self.stream_create_error.set_visible(False)
        page.append(self.stream_create_error)
        page.append(Gtk.Box(vexpand=True))

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.add_css_class("secondary-button")
        cancel.connect("clicked", lambda _button: self.show_list())
        self.stream_create_button = Gtk.Button(label="Create stream and start Pi")
        self.stream_create_button.add_css_class("primary-button")
        self.stream_create_button.connect("clicked", lambda _button: self.create_stream())
        actions.append(cancel)
        actions.append(self.stream_create_button)
        page.append(actions)
        return page

    def load_agent_activity(self):
        activity_root = backend.RUNTIME_ROOT / "pi-activity"
        try:
            if activity_root.is_symlink() or not activity_root.is_dir():
                return {}
            entries = list(activity_root.iterdir())
        except OSError:
            return {}

        known_projects = {
            project["id"]: project for project in self.registry["projects"]
            if not project.get("archivedAt")
        }
        known_streams = {}
        for project_id, project in known_projects.items():
            try:
                known_streams[project_id] = {
                    stream["id"] for stream in backend.load_stream_registry_view(project)["streams"]
                    if not stream.get("archivedAt")
                }
            except Exception:
                known_streams[project_id] = set()

        activity = {}
        for entry in entries:
            try:
                metadata = entry.lstat()
                if metadata.st_size > 4096 or not entry.is_file() or entry.is_symlink():
                    continue
                value = json.loads(entry.read_text())
                pid = value.get("pid")
                project_id = value.get("projectId")
                stream_id = value.get("streamId")
                state = value.get("state")
                if value.get("version") != 1 or state not in ("working", "idle"):
                    continue
                if not isinstance(pid, int) or entry.name != f"{pid}.json" or project_id not in known_projects:
                    continue
                if stream_id is not None and stream_id not in known_streams[project_id]:
                    continue
                environment_bytes = (Path("/proc") / str(pid) / "environ").read_bytes()
                if len(environment_bytes) > 1024 * 1024:
                    continue
                environment = {}
                for item in environment_bytes.split(b"\0"):
                    if b"=" in item:
                        key, raw_value = item.split(b"=", 1)
                        environment[key.decode(errors="ignore")] = raw_value.decode(errors="ignore")
                if environment.get("PROJECT_OBJECT_ID") != project_id:
                    continue
                if environment.get("PROJECT_OBJECT_STREAM_ID") != (stream_id or None):
                    continue
                activity.setdefault((project_id, stream_id), set()).add(state)
            except (OSError, ValueError, TypeError, json.JSONDecodeError):
                continue
        return activity

    def poll_activity(self):
        if self.window and self.window.get_visible():
            current = self.load_agent_activity()
            if current != self.agent_activity:
                self.agent_activity = current
                if self.stack.get_visible_child_name() == "list":
                    self.refresh_rows()
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def context_key(project, stream=None):
        return project["id"], stream["id"] if stream else None

    @staticmethod
    def is_next_attention_key(keyval, state):
        blocked = (
            Gdk.ModifierType.SHIFT_MASK
            | Gdk.ModifierType.CONTROL_MASK
            | Gdk.ModifierType.ALT_MASK
            | Gdk.ModifierType.SUPER_MASK
            | Gdk.ModifierType.HYPER_MASK
            | Gdk.ModifierType.META_MASK
            | Gdk.ModifierType.BUTTON1_MASK
            | Gdk.ModifierType.BUTTON2_MASK
            | Gdk.ModifierType.BUTTON3_MASK
            | Gdk.ModifierType.BUTTON4_MASK
            | Gdk.ModifierType.BUTTON5_MASK
        )
        return (
            not state & blocked
            and keyval in (Gdk.KEY_n, Gdk.KEY_N)
            and (keyval != Gdk.KEY_N or bool(state & Gdk.ModifierType.LOCK_MASK))
        )

    def context_targets(self):
        targets = []
        for project in self.registry["projects"]:
            if project.get("archivedAt"):
                continue
            targets.append((project, None))
            try:
                streams = backend.load_stream_registry_view(project)["streams"]
            except Exception:
                continue
            targets.extend((project, stream) for stream in streams if not stream.get("archivedAt"))
        return targets

    def preload_context_cache(self):
        self.context_scope_targets = self.context_targets()
        for project, stream in self.context_scope_targets:
            try:
                self.context_cache[self.context_key(project, stream)] = backend.load_scope_context(project, stream)
            except Exception:
                continue

    @staticmethod
    def context_age_text(value):
        if not value:
            return ""
        try:
            recorded = datetime.fromisoformat(value.replace("Z", "+00:00"))
            if recorded.tzinfo is None:
                recorded = recorded.replace(tzinfo=timezone.utc)
            seconds = max(0, int((datetime.now(timezone.utc) - recorded).total_seconds()))
        except (TypeError, ValueError):
            return ""
        if seconds < 60:
            return "just now"
        if seconds < 3600:
            return f"{seconds // 60} min ago"
        if seconds < 86400:
            return f"{seconds // 3600} h ago"
        return f"{seconds // 86400} d ago"

    def project_preview_target(self, project):
        targets = [
            (target_project, target_stream)
            for target_project, target_stream in self.context_scope_targets
            if target_project["id"] == project["id"]
        ] or [(project, None)]
        for target_project, target_stream in targets:
            key = self.context_key(target_project, target_stream)
            context = self.context_cache.get(key, {})
            states = self.agent_activity.get(key, set())
            if "working" not in states and context.get("briefAttention") in ("review", "decision", "action"):
                return target_project, target_stream
        for state in ("idle", "working"):
            for target_project, target_stream in targets:
                key = self.context_key(target_project, target_stream)
                if state in self.agent_activity.get(key, set()):
                    return target_project, target_stream

        def updated_at(target):
            target_project, target_stream = target
            context = self.context_cache.get(self.context_key(target_project, target_stream), {})
            return context.get("updatedAt") or ""

        return max(targets, key=updated_at)

    def row_context_target(self, row):
        if isinstance(row, StreamRow):
            return row.project, row.stream
        if isinstance(row, ProjectWorkspaceRow):
            return row.project, None
        if isinstance(row, ProjectRow):
            return self.project_preview_target(row.project)
        return None

    @staticmethod
    def picker_preview_text(value, maximum=160):
        if not value:
            return None
        compact = " ".join(value.split())
        if len(compact) <= maximum:
            return compact
        shortened = compact[:maximum - 1].rsplit(" ", 1)[0]
        return f"{shortened or compact[:maximum - 1]}…"

    def paint_context_inspector(self, refresh=False):
        if not hasattr(self, "context_inspector"):
            return
        row = self.listbox.get_selected_row()
        target = self.row_context_target(row)
        if not target:
            return
        project, stream = target
        key = self.context_key(project, stream)
        if refresh or key not in self.context_cache:
            try:
                self.context_cache[key] = backend.load_scope_context(project, stream)
            except Exception:
                self.context_cache.setdefault(key, {})
        context = self.context_cache.get(key, {})

        scope_name = stream["name"] if stream else ("Project workspace" if isinstance(row, ProjectWorkspaceRow) else None)
        self.context_title.set_text(f"{project['name']}  ›  {scope_name}" if scope_name else project["name"])
        states = self.agent_activity.get(self.context_key(project, stream), set())
        attention = context.get("briefAttention")
        for css_class in (
            "context-status-idle", "context-status-working", "context-status-review",
            "context-status-decision", "context-status-action", "context-status-none",
        ):
            self.context_status.remove_css_class(css_class)
        if "working" in states:
            self.context_status.set_text("●  AGENT WORKING")
            self.context_status.add_css_class("context-status-working")
        elif attention == "decision":
            self.context_status.set_text("◆  DECISION NEEDED")
            self.context_status.add_css_class("context-status-decision")
        elif attention == "review":
            self.context_status.set_text("●  READY FOR REVIEW")
            self.context_status.add_css_class("context-status-review")
        elif attention == "action":
            self.context_status.set_text("◆  YOUR ACTION NEEDED")
            self.context_status.add_css_class("context-status-action")
        elif "idle" in states:
            self.context_status.set_text("●  AGENT SETTLED")
            self.context_status.add_css_class("context-status-idle")
        else:
            self.context_status.set_text("○  NO ATTACHED AGENT")
            self.context_status.add_css_class("context-status-none")
        self.context_age.set_text(self.context_age_text(context.get("updatedAt")))
        current = context.get("briefCurrent") or self.picker_preview_text(context.get("happening"))
        next_step = context.get("briefNext") or self.picker_preview_text(context.get("next"))
        self.context_current.set_text(current or "No current briefing has been recorded for this scope.")
        self.context_next.set_text(next_step or "No next action has been recorded.")
        self.context_details.set_text(context.get("detail") or "No additional worklog detail is recorded.")
        self.context_source.set_text(
            "Agent-authored picker brief · detailed evidence remains in the worklog" if context.get("briefCurrent")
            else "Legacy worklog preview · future agent updates will provide a concise brief" if context.get("hasWorklog")
            else "No recorded worklog source"
        )

    def poll_context(self):
        if (
            not self.window
            or not self.window.get_visible()
            or self.stack.get_visible_child_name() != "list"
            or self.context_refresh_pending
        ):
            return GLib.SOURCE_CONTINUE
        self.context_refresh_pending = True

        def refresh():
            contexts = {}
            targets = self.context_targets()
            for project, stream in targets:
                try:
                    contexts[self.context_key(project, stream)] = backend.load_scope_context(project, stream)
                except Exception:
                    continue
            GLib.idle_add(self.finish_context_refresh, contexts, targets)

        threading.Thread(target=refresh, name="picker-context-refresh", daemon=True).start()
        return GLib.SOURCE_CONTINUE

    def finish_context_refresh(self, contexts, targets):
        self.context_cache.update(contexts)
        self.context_scope_targets = targets
        self.context_refresh_pending = False
        if (
            self.window
            and self.window.get_visible()
            and self.context_open
            and self.stack.get_visible_child_name() == "list"
        ):
            self.paint_context_inspector()
        return GLib.SOURCE_REMOVE

    def apply_window_size(self, width):
        self.window.set_size_request(width, WINDOW_HEIGHT)
        self.window.set_default_size(width, WINDOW_HEIGHT)
        try:
            clients = backend.hypr_json("clients")
            address = next(
                str(client.get("address"))
                for client in clients
                if isinstance(client, dict) and client.get("pid") == os.getpid()
                and str(client.get("address", "")).startswith("0x")
            )
            result = backend.run([
                backend.HYPRCTL,
                "dispatch",
                "resizewindowpixel",
                f"exact {width} {WINDOW_HEIGHT},address:{address}",
            ])
            if result.returncode != 0:
                raise RuntimeError("Hyprland refused the picker resize")
        except (OSError, RuntimeError, StopIteration, TypeError) as error:
            backend.notify_error(f"The context inspector changed, but the picker could not resize: {error}")
        return GLib.SOURCE_REMOVE

    def toggle_context_details(self):
        if not self.context_open:
            return
        self.context_details_open = not self.context_details_open
        self.context_details_box.set_visible(self.context_details_open)

    def toggle_context_inspector(self):
        self.context_open = not self.context_open
        if not self.context_open:
            self.context_details_open = False
            self.context_details_box.set_visible(False)
        self.context_separator.set_visible(self.context_open)
        self.context_inspector.set_visible(self.context_open)
        width = INSPECTOR_WIDTH if self.context_open else COMPACT_WIDTH
        GLib.idle_add(self.apply_window_size, width)
        if self.context_open:
            self.paint_context_inspector(refresh=True)
        try:
            self.save_picker_state()
        except Exception as error:
            backend.notify_error(str(error))

    def scope_requires_attention(self, project, stream=None):
        scope = backend.stream_scope(project, stream) if stream else backend.project_scope(project)
        workspace = backend.stream_workspace_name(project, stream) if stream else backend.workspace_name(project)
        if self.current_workspace != workspace and not backend.scope_is_open(self.session, scope):
            return False
        states = self.agent_activity.get(self.context_key(project, stream), set())
        return "idle" in states and "working" not in states

    def attention_scopes(self):
        scopes = []
        for project, stream in self.context_scope_targets:
            if not self.scope_requires_attention(project, stream):
                continue
            if stream:
                scopes.append({"kind": "stream", "projectId": project["id"], "streamId": stream["id"]})
            else:
                scopes.append({"kind": "project", "projectId": project["id"]})
        return scopes

    def show_workspace_label(self, workspace):
        # One transient notification, replaced on rapid cycling; failures must
        # never turn a successful workspace switch into a navigation error.
        try:
            subprocess.run(
                [backend.NOTIFY, "--app-name=Project Workspace", "--transient",
                 "--expire-time=1500",
                 "--hint=string:x-dunst-stack-tag:project-object-workspace",
                 "--", workspace],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                check=False, timeout=2,
            )
        except (OSError, subprocess.TimeoutExpired):
            pass

    def jump_previous_attention(self):
        return self.jump_next_attention(direction=-1)

    def jump_next_attention(self, direction=1):
        """Global Super+[Shift+]n: focus a settled scope without showing the picker."""
        if self.destructive_action_pending:
            return GLib.SOURCE_CONTINUE
        try:
            self.registry = backend.load_registry()
            self.session = backend.reconcile_session(self.registry, backend.load_session())
            self.current_workspace = backend.active_workspace_name()
            self.context_scope_targets = self.context_targets()
            self.agent_activity = self.load_agent_activity()
            scopes = self.attention_scopes()
            ordered = []
            for project, stream in self.context_scope_targets:
                scope = backend.stream_scope(project, stream) if stream else backend.project_scope(project)
                workspace = backend.stream_workspace_name(project, stream) if stream else backend.workspace_name(project)
                ordered.append((scope, workspace))
            anchor = next((index for index, (_, workspace) in enumerate(ordered)
                           if workspace == self.current_workspace), -1 if direction == 1 else 0)
            for offset in range(1, len(ordered) + 1):
                scope, workspace = ordered[(anchor + direction * offset) % len(ordered)]
                if scope not in scopes:
                    continue
                result = backend.run([backend.HYPRCTL, "dispatch", "workspace", f"name:{workspace}"])
                if result.returncode != 0:
                    raise RuntimeError("Could not switch to the green-dot workspace")
                self.selected_scope = scope
                self.expanded_project_ids.add(scope["projectId"])
                self.save_picker_state()
                self.dismiss_window()
                self.show_workspace_label(workspace)
                return GLib.SOURCE_CONTINUE
            backend.notify_warning("No open workspace has a settled agent")
        except Exception as error:
            backend.notify_error(str(error))
        return GLib.SOURCE_CONTINUE

    def select_next_attention(self):
        scopes = self.attention_scopes()
        if not scopes:
            self.footer_hint.set_text("No open workspace has a settled agent")
            GLib.timeout_add_seconds(2, self.restore_footer_hint)
            return
        ordered = [
            backend.stream_scope(project, stream) if stream else backend.project_scope(project)
            for project, stream in self.context_scope_targets
        ]
        anchor = self.selected_scope
        header = anchor and anchor.get("kind") == "project-header"
        if header:
            anchor = {"kind": "project", "projectId": anchor["projectId"]}
        try:
            index = ordered.index(anchor) - int(bool(header))
        except ValueError:
            index = -1
        self.selected_scope = next(
            scope for offset in range(1, len(ordered) + 1)
            if (scope := ordered[(index + offset) % len(ordered)]) in scopes
        )
        self.expanded_project_ids.add(self.selected_scope["projectId"])
        try:
            self.save_picker_state()
            # The destination must be visible even if the current search hides it.
            if self.search.get_text():
                self.search.set_text("")
            self.refresh_rows()
            row = self.listbox.get_selected_row()
            if row:
                # Wait for the frame's layout after expanding/filtering, then
                # center using the new row bounds and scroll adjustment range.
                row.add_tick_callback(self.center_row_after_layout)
        except Exception as error:
            backend.notify_error(str(error))

    def center_row_after_layout(self, row, _clock):
        GLib.idle_add(self.reveal_row, row, True)
        return GLib.SOURCE_REMOVE

    def restore_footer_hint(self):
        if self.stack.get_visible_child_name() == "list" and self.pending_stream_open_id is None:
            self.footer_hint.set_text(FOOTER_HINT)
        return GLib.SOURCE_REMOVE

    @property
    def picker_state_path(self):
        return backend.RUNTIME_ROOT / "picker-state.json"

    def load_picker_state(self):
        self.expanded_project_ids = set()
        self.selected_scope = None
        self.context_open = False
        try:
            value = backend.read_json(self.picker_state_path, {})
        except Exception:
            value = {}
        known_ids = {project["id"] for project in self.registry["projects"] if not project.get("archivedAt")}
        restored = value.get("version") == 1 and value.get("hyprlandInstance") == backend.HYPRLAND_INSTANCE
        if restored:
            self.context_open = value.get("contextOpen") is True
            self.expanded_project_ids = {
                project_id for project_id in value.get("expandedProjectIds", [])
                if project_id in known_ids
            }
            selection = value.get("selection")
            if isinstance(selection, dict) and selection.get("projectId") in known_ids:
                self.selected_scope = selection
                if selection.get("kind") == "project":
                    self.expanded_project_ids.add(selection["projectId"])

        # On first use in a compositor session, reveal and select the active
        # scope. Explicitly saved expansion and selection otherwise win.
        if not restored:
            for project in self.registry["projects"]:
                if project.get("archivedAt"):
                    continue
                if self.current_workspace == project["name"]:
                    self.expanded_project_ids.add(project["id"])
                    self.selected_scope = {"kind": "project", "projectId": project["id"]}
                    break
                if self.current_workspace == backend.project_browser_workspace_name(project):
                    self.selected_scope = {"kind": "project-header", "projectId": project["id"]}
                    break
                try:
                    streams = backend.load_stream_registry_view(project)["streams"]
                except Exception:
                    continue
                current_stream = next((
                    stream for stream in streams
                    if not stream.get("archivedAt")
                    and backend.stream_workspace_name(project, stream) == self.current_workspace
                ), None)
                if current_stream:
                    self.expanded_project_ids.add(project["id"])
                    self.selected_scope = {
                        "kind": "stream",
                        "projectId": project["id"],
                        "streamId": current_stream["id"],
                    }
                    break

    def save_picker_state(self):
        backend.write_json_atomic(self.picker_state_path, {
            "version": 1,
            "hyprlandInstance": backend.HYPRLAND_INSTANCE,
            "expandedProjectIds": sorted(self.expanded_project_ids),
            "selection": self.selected_scope,
            "contextOpen": self.context_open,
        })

    @staticmethod
    def row_scope(row):
        if isinstance(row, StreamRow):
            return {"kind": "stream", "projectId": row.project["id"], "streamId": row.stream["id"]}
        if isinstance(row, ProjectWorkspaceRow):
            return {"kind": "project", "projectId": row.project["id"]}
        if isinstance(row, ProjectRow):
            return {"kind": "project-header", "projectId": row.project["id"]}
        return None

    def on_row_selected(self, _listbox, row):
        if row is None:
            return
        self.selected_scope = self.row_scope(row)
        if self.context_open:
            self.paint_context_inspector()
        try:
            self.save_picker_state()
        except Exception as error:
            backend.notify_error(str(error))

    def project_items(self):
        return backend.project_picker_items(self.registry, self.session, self.current_workspace)

    def stream_items(self, project, registry=None):
        return backend.stream_picker_items(
            project,
            registry if registry is not None else backend.load_stream_registry_view(project),
            self.session,
            self.current_workspace,
        )

    def list_rows(self):
        query = self.search.get_text().strip().casefold() if hasattr(self, "search") else ""
        values = []
        for project, _state in self.project_items():
            state = (
                "current" if self.current_workspace == backend.workspace_name(project)
                else "open" if backend.scope_is_open(self.session, backend.project_scope(project))
                else "closed"
            )
            project_matches = query in project["name"].casefold() or query in project["mainDirectory"].casefold()
            expanded = project["id"] in self.expanded_project_ids
            stream_view = backend.load_stream_registry_view(project)
            streams = self.stream_items(project, stream_view)
            errors = stream_view["errors"]
            matching_streams = [item for item in streams if query in item[0]["name"].casefold()] if query else streams
            if query and not project_matches and not matching_streams and not any(query in error.casefold() for error in errors):
                continue
            working_stream_ids = {
                stream["id"] for stream, stream_state in streams
                if stream_state != "closed" and "working" in self.agent_activity.get((project["id"], stream["id"]), set())
            }
            project_working = state != "closed" and "working" in self.agent_activity.get((project["id"], None), set())
            project_agent_states = set()
            for scope_stream, scope_state in [(None, state), *streams]:
                if scope_state == "closed":
                    continue
                states = self.agent_activity.get(self.context_key(project, scope_stream), set())
                if "working" in states:
                    project_agent_states.add("working")
                elif "idle" in states:
                    project_agent_states.add("idle")
            values.append(ProjectRow(
                project,
                expanded=expanded,
                agent_states=project_agent_states,
                errors=errors,
            ))
            if expanded or query:
                values.extend(StreamRegistryErrorRow(error) for error in errors if not query or project_matches or query in error.casefold())
                if not query or project_matches:
                    values.append(ProjectWorkspaceRow(project, state, working=project_working))
                for stream, stream_state in matching_streams:
                    values.append(StreamRow(
                        project,
                        stream,
                        stream_state,
                        working=stream["id"] in working_stream_ids,
                    ))
        return values

    def refresh_rows(self):
        desired = self.selected_scope
        previous = list(self.rows)
        rows = []
        for candidate in self.list_rows():
            row = next((old for old in previous if old.render_key == candidate.render_key), candidate)
            if row is not candidate:
                previous.remove(row)
                if isinstance(row, ProjectRow):
                    row.arrow.set_label(candidate.arrow.get_label())
            rows.append(row)
        # Keep unchanged widgets mapped: removing/reinserting a Gtk.Spinner
        # resets its animation even when the same Python object is reused.
        for row in previous:
            self.listbox.remove(row)
        selected = None
        self.rows = rows
        for index, row in enumerate(rows):
            if self.listbox.get_row_at_index(index) is not row:
                if row.get_parent() is self.listbox:
                    self.listbox.remove(row)
                self.listbox.insert(row, index)
            if desired and self.row_scope(row) == desired:
                selected = row
        if self.rows:
            self.select_visible_row(selected or self.rows[0])

    def select_visible_row(self, row):
        self.listbox.select_row(row)
        GLib.idle_add(self.reveal_row, row)

    def reveal_row(self, row, center=False):
        if row not in self.rows or row.get_parent() is not self.listbox:
            return GLib.SOURCE_REMOVE
        if center and self.listbox.get_selected_row() is not row:
            return GLib.SOURCE_REMOVE
        computed, bounds = row.compute_bounds(self.listbox)
        if computed:
            adjustment = self.list_scroll.get_vadjustment()
            if center:
                target = bounds.get_y() + bounds.get_height() / 2 - adjustment.get_page_size() / 2
                adjustment.set_value(max(adjustment.get_lower(), min(
                    target, adjustment.get_upper() - adjustment.get_page_size(),
                )))
            else:
                adjustment.clamp_page(bounds.get_y(), bounds.get_y() + bounds.get_height())
        return GLib.SOURCE_REMOVE

    def move_selection(self, delta):
        if not self.rows:
            return
        selected = self.listbox.get_selected_row()
        index = self.rows.index(selected) if selected in self.rows else 0
        index = (index + delta) % len(self.rows)
        self.select_visible_row(self.rows[index])

    def select_edge(self, last=False):
        if self.rows:
            self.select_visible_row(self.rows[-1 if last else 0])

    def focus_normal_mode(self):
        self.search_mode = False
        self.pending_g = False
        self.set_normal_actions_enabled(True)
        self.listbox.grab_focus()

    def enter_search_mode(self):
        self.search_mode = True
        self.pending_g = False
        self.set_normal_actions_enabled(False)
        self.search.grab_focus()

    def toggle_all_projects(self):
        project_ids = {project["id"] for project, _state in self.project_items()}
        if self.expanded_project_ids & project_ids:
            self.expanded_project_ids.clear()
            if self.selected_scope:
                self.selected_scope = {
                    "kind": "project-header", "projectId": self.selected_scope["projectId"],
                }
            # A search reveals children even for collapsed projects.
            self.search.set_text("")
        else:
            self.expanded_project_ids = project_ids
        try:
            self.save_picker_state()
            self.refresh_rows()
        except Exception as error:
            backend.notify_error(str(error))

    def toggle_selected_project(self):
        row = self.listbox.get_selected_row()
        if not isinstance(row, (ProjectRow, ProjectWorkspaceRow, StreamRow)):
            return
        project = row.project
        project_id = project["id"]
        if project_id in self.expanded_project_ids:
            self.expanded_project_ids.remove(project_id)
            self.selected_scope = {"kind": "project-header", "projectId": project_id}
        else:
            self.expanded_project_ids.add(project_id)
        try:
            self.save_picker_state()
            self.refresh_rows()
        except Exception as error:
            backend.notify_error(str(error))

    def open_selected(self):
        row = self.listbox.get_selected_row()
        if not row:
            return
        if isinstance(row, StreamRegistryErrorRow):
            backend.notify_error(row.error)
            return
        self.selected_scope = self.row_scope(row)
        try:
            self.save_picker_state()
            if isinstance(row, ProjectRow):
                self.toggle_selected_project()
                return
            if isinstance(row, ProjectWorkspaceRow):
                backend.enter_project(row.project, self.session, row.state == "closed")
            else:
                self.prepare_existing_stream_open(row.project, row.stream, row.state == "closed")
                return
        except Exception as error:
            backend.notify_error(str(error))
            return
        self.dismiss_window()

    def resume_stream_pi(self):
        row = self.listbox.get_selected_row()
        if not isinstance(row, StreamRow):
            backend.notify_error("Select a stream before resuming Pi")
            return
        self.prepare_existing_stream_open(row.project, row.stream, True, pi_arguments=["--continue"])

    def prepare_existing_stream_open(self, project, stream, launch_terminal, pi_arguments=None):
        if self.pending_stream_open_id is not None:
            return
        self.pending_stream_open_id = stream["id"]
        self.set_normal_actions_enabled(False)
        self.footer_hint.set_text(f"Preparing {stream['name']}…")

        def prepare():
            try:
                backend.prepare_stream_worktree(project, stream)
                error = None
            except Exception as preparation_error:
                error = str(preparation_error)
            GLib.idle_add(self.finish_existing_stream_open, project, stream, launch_terminal, pi_arguments, error)

        threading.Thread(target=prepare, name="existing-stream-worktree-preparation", daemon=True).start()

    def finish_existing_stream_open(self, project, stream, launch_terminal, pi_arguments, error):
        if self.pending_stream_open_id != stream["id"]:
            return False
        self.pending_stream_open_id = None
        if error:
            backend.notify_error(f"Could not prepare {stream['name']}: {error}")
            self.show_list()
            return False
        try:
            backend.enter_stream(project, stream, self.session, launch_terminal, pi_arguments=pi_arguments)
        except Exception as open_error:
            backend.notify_error(str(open_error))
            self.show_list()
            return False
        self.dismiss_window()
        return False

    def add_vim_dialog_navigation(self, dialog, confirm_response):
        """Give confirmation dialogs the same keyboard language as the picker."""
        keys = Gtk.EventControllerKey.new()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)

        def navigate(_controller, keyval, _keycode, modifiers):
            if modifiers & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK | Gdk.ModifierType.SUPER_MASK):
                return False
            if keyval in (Gdk.KEY_j, Gdk.KEY_l):
                dialog.child_focus(Gtk.DirectionType.TAB_FORWARD)
                return True
            if keyval in (Gdk.KEY_k, Gdk.KEY_h):
                dialog.child_focus(Gtk.DirectionType.TAB_BACKWARD)
                return True
            if keyval == Gdk.KEY_y:
                dialog.response(confirm_response)
                return True
            if keyval in (Gdk.KEY_n, Gdk.KEY_q):
                dialog.response("cancel")
                return True
            return False

        keys.connect("key-pressed", navigate)
        dialog.add_controller(keys)

    def request_close_active_workspace(self):
        if self.destructive_action_pending:
            return True
        try:
            registry = backend.load_registry()
            active_workspace = backend.active_workspace_name()
            selected_scope = None
            for project in registry["projects"]:
                if project.get("archivedAt"):
                    continue
                if backend.workspace_name(project) == active_workspace:
                    selected_scope = {"kind": "project", "projectId": project["id"]}
                    break
                streams = backend.load_stream_registry_view(project)["streams"]
                stream = next((
                    item for item in streams
                    if not item.get("archivedAt")
                    and backend.stream_workspace_name(project, item) == active_workspace
                ), None)
                if stream:
                    selected_scope = {
                        "kind": "stream",
                        "projectId": project["id"],
                        "streamId": stream["id"],
                    }
                    break
        except Exception as error:
            backend.notify_error(str(error))
            return True
        if selected_scope is None:
            backend.notify_error("Super+X only closes an active project or stream workspace")
            return True

        self.expanded_project_ids.add(selected_scope["projectId"])
        self.selected_scope = selected_scope

        def present_confirmation():
            self.refresh_rows()
            row = next((item for item in self.rows if self.row_scope(item) == selected_scope), None)
            if row is None:
                backend.notify_error("The active workspace is no longer available to close")
                return
            self.select_visible_row(row)
            self.request_close_workspace()

        self.show_window(after_place=present_confirmation)
        return True

    def request_close_workspace(self):
        if self.destructive_action_pending:
            return
        row = self.listbox.get_selected_row()
        if not row:
            return
        if not isinstance(row, (ProjectWorkspaceRow, StreamRow)):
            backend.notify_error("Select a project workspace or stream before closing")
            return
        stream = row.stream if isinstance(row, StreamRow) else None
        scope_name = stream["name"] if stream else f"{row.project['name']} project workspace"
        if row.state == "closed":
            backend.notify_error(f"{scope_name} is already closed")
            return
        workspace = backend.stream_workspace_name(row.project, stream) if stream else backend.workspace_name(row.project)
        try:
            window_count = len(backend.workspace_clients(workspace))
        except Exception as error:
            backend.notify_error(str(error))
            return
        retained = "Pi sessions and stream artifacts are retained." if stream else "All stream workspaces remain open and independent."
        dialog = Adw.MessageDialog.new(
            self.window,
            f"Close {scope_name}?",
            f"This will snapshot the workspace and ask {window_count} window(s) to close. {retained}",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("close", "Close workspace")
        dialog.set_response_appearance("close", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        self.add_vim_dialog_navigation(dialog, "close")
        self.destructive_action_pending = True

        def responded(_dialog, response):
            _dialog.close()
            if response != "close":
                self.destructive_action_pending = False
                return

            self.window.set_sensitive(False)

            def finish(error):
                self.destructive_action_pending = False
                self.window.set_sensitive(True)
                if error:
                    backend.notify_error(str(error))
                    return GLib.SOURCE_REMOVE
                try:
                    self.session = backend.reconcile_session(self.registry, backend.load_session())
                    self.current_workspace = backend.active_workspace_name()
                    self.move_picker_to_active_workspace()
                    self.refresh_rows()
                    self.window.present()
                except Exception as refresh_error:
                    backend.notify_error(str(refresh_error))
                return GLib.SOURCE_REMOVE

            def close_in_background():
                try:
                    if stream:
                        backend.close_stream(row.project, stream, self.session)
                    else:
                        backend.close_project(row.project, self.session)
                except Exception as error:
                    GLib.idle_add(finish, error)
                    return
                GLib.idle_add(finish, None)

            threading.Thread(target=close_in_background, name="project-workspace-close", daemon=True).start()

        dialog.connect("response", responded)
        dialog.present()

    def request_archive_project(self):
        if self.destructive_action_pending:
            return
        row = self.listbox.get_selected_row()
        if not isinstance(row, ProjectRow):
            backend.notify_error("Select a project row before archiving")
            return
        try:
            streams = [
                stream for stream in backend.load_stream_registry(row.project)["streams"]
                if not stream.get("archivedAt")
            ]
        except Exception as error:
            backend.notify_error(str(error))
            return

        stream_text = f" and its {len(streams)} stream{'s' if len(streams) != 1 else ''}" if streams else ""
        dialog = Adw.MessageDialog.new(
            self.window,
            f"Archive {row.project['name']}?",
            f"The project workspace{stream_text} will be snapshotted and closed first. Artifacts and Pi sessions are retained, and the project will disappear from the normal picker.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("archive", "Archive project")
        dialog.set_response_appearance("archive", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        self.add_vim_dialog_navigation(dialog, "archive")
        self.destructive_action_pending = True

        def responded(_dialog, response):
            _dialog.close()
            if response != "archive":
                self.destructive_action_pending = False
                return
            self.window.set_sensitive(False)

            def finish(error):
                self.destructive_action_pending = False
                self.window.set_sensitive(True)
                try:
                    self.current_workspace = backend.active_workspace_name()
                    self.move_picker_to_active_workspace()
                    self.window.present()
                except Exception as relocation_error:
                    backend.notify_error(str(relocation_error))
                if error:
                    backend.notify_error(str(error))
                    return GLib.SOURCE_REMOVE
                try:
                    self.registry = backend.load_registry()
                    self.session = backend.reconcile_session(self.registry, backend.load_session())
                    self.expanded_project_ids.discard(row.project["id"])
                    self.selected_scope = None
                    self.save_picker_state()
                    self.refresh_rows()
                except Exception as refresh_error:
                    backend.notify_error(str(refresh_error))
                return GLib.SOURCE_REMOVE

            def archive_in_background():
                try:
                    backend.archive_project(row.project, self.registry, self.session)
                except Exception as error:
                    GLib.idle_add(finish, error)
                    return
                GLib.idle_add(finish, None)

            threading.Thread(target=archive_in_background, name="project-archive", daemon=True).start()

        dialog.connect("response", responded)
        dialog.present()

    def move_picker_to_workspace(self, workspace_name):
        clients = backend.hypr_json("clients")
        if not isinstance(clients, list):
            return False
        for client in clients:
            if not isinstance(client, dict) or client.get("pid") != os.getpid():
                continue
            classes = {str(client.get("class", "")), str(client.get("initialClass", ""))}
            address = str(client.get("address", ""))
            if classes.isdisjoint({"project-picker", "dev.project_object.Picker"}) or not address.startswith("0x"):
                continue
            target = "current" if workspace_name == "current" else f"name:{workspace_name}"
            result = backend.run([
                backend.HYPRCTL,
                "dispatch",
                "movetoworkspacesilent",
                f"{target},address:{address}",
            ])
            if result.returncode != 0:
                raise RuntimeError("The picker could not move to the active workspace")
            focus = backend.run([
                backend.HYPRCTL,
                "dispatch",
                "focuswindow",
                f"address:{address}",
            ])
            if focus.returncode != 0:
                raise RuntimeError("The picker moved, but could not take focus")
            return True
        return False

    def move_picker_to_active_workspace(self):
        return self.move_picker_to_workspace("current")

    def show_create(self):
        self.create_error.set_visible(False)
        self.directory_selected_path = None
        self.directory_suggestions_scroll.set_visible(False)
        self.directory_hint.set_visible(False)
        self.set_normal_actions_enabled(False)
        self.stack.set_visible_child_name("create")
        self.load_directory_candidates()
        self.name_entry.grab_focus()

    def show_list(self):
        self.pending_stream_id = None
        self.list_title.set_text("Projects")
        self.footer_hint.set_text(FOOTER_HINT)
        self.search.set_placeholder_text("Press / to search projects and streams…")
        self.stack.set_visible_child_name("list")
        self.refresh_rows()
        self.focus_normal_mode()

    def show_create_stream(self):
        row = self.listbox.get_selected_row()
        if not isinstance(row, (ProjectRow, ProjectWorkspaceRow, StreamRow)):
            backend.notify_error("Select a project or healthy stream before creating a stream")
            return
        self.selected_project = row.project
        try:
            self.stream_registry = backend.load_stream_registry(self.selected_project)
        except Exception as error:
            backend.notify_error(str(error))
            return
        self.stream_create_error.set_visible(False)
        self.set_normal_actions_enabled(False)
        selected_project = self.selected_project
        project_id = selected_project["id"]
        self.stream_repository_candidates = None
        self.stream_create_copy.set_text(f"Create a focused scope inside {self.selected_project['name']}. Detecting Git repositories…")
        self.stream_name_entry.set_text("")
        self.stream_repository_entry.set_text("")
        self.stream_no_worktree.set_active(False)
        self.stream_create_button.set_sensitive(False)
        self.stack.set_visible_child_name("create-stream")
        self.stream_name_entry.grab_focus()

        def discover():
            try:
                candidates = backend.immediate_git_repositories(selected_project["mainDirectory"])
                error = None
            except Exception as discovery_error:
                candidates = []
                error = str(discovery_error)
            GLib.idle_add(self.finish_stream_repository_discovery, project_id, candidates, error)

        threading.Thread(target=discover, name="stream-repository-discovery", daemon=True).start()

    def finish_stream_repository_discovery(self, project_id, candidates, error):
        if self.stack.get_visible_child_name() != "create-stream" or not self.selected_project or self.selected_project["id"] != project_id:
            return False
        self.stream_repository_candidates = candidates
        if error:
            repository_hint = f" Repository detection failed: {error}. Enter a repository or mark this as non-code."
        elif len(candidates) == 1:
            repository_hint = f" Git isolation will use {candidates[0]}."
            if not self.stream_repository_entry.get_text().strip():
                self.stream_repository_entry.set_text(candidates[0])
        elif len(candidates) > 1:
            repository_hint = " Choose which repository this stream will modify."
        else:
            repository_hint = " No Git repository was detected; enter one or mark this as a non-code stream."
        self.stream_create_copy.set_text(f"Create a focused scope inside {self.selected_project['name']}.{repository_hint}")
        self.stream_create_button.set_sensitive(True)
        return False

    def create_stream(self):
        if self.stream_repository_candidates is None:
            return
        repository = self.stream_repository_entry.get_text().strip() or None
        use_worktree = not self.stream_no_worktree.get_active()
        if use_worktree and not repository:
            message = "Choose a Git repository for this stream." if self.stream_repository_candidates else "Enter a Git repository or mark this as a non-code stream."
            self.stream_create_error.set_text(message)
            self.stream_create_error.set_visible(True)
            return
        try:
            stream = backend.create_stream(
                self.selected_project,
                self.stream_registry,
                self.stream_name_entry.get_text(),
                repository=repository,
                use_worktree=use_worktree,
            )
            self.expanded_project_ids.add(self.selected_project["id"])
            self.selected_scope = {"kind": "stream", "projectId": self.selected_project["id"], "streamId": stream["id"]}
            self.save_picker_state()
        except Exception as error:
            self.stream_create_error.set_text(str(error))
            self.stream_create_error.set_visible(True)
            return

        project = self.selected_project
        self.pending_stream_id = stream["id"]
        self.stream_create_button.set_sensitive(False)
        self.stream_create_copy.set_text(f"Preparing {stream['name']}…")

        def prepare_and_open():
            try:
                backend.prepare_stream_worktree(project, stream)
                error = None
            except Exception as preparation_error:
                error = str(preparation_error)
            GLib.idle_add(self.finish_stream_start, stream, error)

        threading.Thread(target=prepare_and_open, name="stream-worktree-preparation", daemon=True).start()

    def finish_stream_start(self, stream, error):
        if self.stack.get_visible_child_name() != "create-stream" or self.pending_stream_id != stream["id"]:
            return False
        if error:
            self.stream_create_error.set_text(f"Stream created, but could not be opened: {error}")
            self.stream_create_error.set_visible(True)
            self.stream_create_copy.set_text(f"{stream['name']} is available in the picker.")
            self.stream_create_button.set_sensitive(False)
            return False
        try:
            backend.enter_stream(self.selected_project, stream, self.session, True, pi_arguments=[])
        except Exception as open_error:
            self.stream_create_error.set_text(f"Stream created, but could not be opened: {open_error}")
            self.stream_create_error.set_visible(True)
            self.stream_create_copy.set_text(f"{stream['name']} is available in the picker.")
            return False
        self.dismiss_window()
        return False

    def load_directory_candidates(self):
        if self.directory_candidates_loaded or self.directory_candidates_loading:
            self.refresh_directory_suggestions()
            return
        self.directory_candidates_loading = True
        self.refresh_directory_suggestions()

        known = []
        for project in self.registry.get("projects", []):
            directory = project.get("mainDirectory")
            if isinstance(directory, str) and directory not in known:
                known.append(directory)
        home = Path.home()
        for common in (home / "matrix", home / "projects", home / "Projects", home):
            if common.is_dir() and str(common) not in known:
                known.append(str(common))

        def discover():
            candidates = list(known)
            seen = set(candidates)
            command = [
                os.environ.get("PROJECT_PICKER_FD", "fd"),
                "--type", "d",
                "--absolute-path",
                "--hidden",
                "--max-depth", "7",
                "--max-results", "12000",
            ]
            for excluded in (".git", ".cache", ".local", "node_modules", "target", ".venv", "__pycache__"):
                command.extend(("--exclude", excluded))
            command.extend((".", str(home)))
            try:
                result = subprocess.run(
                    command,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=8,
                    check=False,
                )
                if result.returncode == 0:
                    for line in result.stdout.splitlines():
                        directory = line.rstrip(os.sep) or os.sep
                        if directory.startswith(os.sep) and directory not in seen:
                            candidates.append(directory)
                            seen.add(directory)
            except (OSError, subprocess.SubprocessError):
                pass
            GLib.idle_add(self.finish_directory_discovery, candidates)

        threading.Thread(target=discover, name="directory-discovery", daemon=True).start()

    def finish_directory_discovery(self, candidates):
        self.directory_candidates = candidates
        self.directory_candidates_loading = False
        self.directory_candidates_loaded = True
        self.refresh_directory_suggestions()
        return GLib.SOURCE_REMOVE

    def on_directory_changed(self, _entry):
        if self.directory_entry.get_text() != self.directory_selected_path:
            self.directory_selected_path = None
        self.refresh_directory_suggestions()

    def refresh_directory_suggestions(self):
        if not hasattr(self, "directory_suggestions"):
            return
        while child := self.directory_suggestions.get_first_child():
            self.directory_suggestions.remove(child)

        if self.directory_selected_path == self.directory_entry.get_text():
            self.directory_suggestions_scroll.set_visible(False)
            self.directory_hint.set_text("Selected directory")
            self.directory_hint.set_visible(True)
            return

        if self.directory_candidates_loading:
            self.directory_suggestions_scroll.set_visible(False)
            self.directory_hint.set_text("Loading directories…")
            self.directory_hint.set_visible(self.directory_entry.has_focus())
            return

        matches = backend.fuzzy_directory_matches(
            self.directory_entry.get_text(),
            self.directory_candidates,
            limit=7,
            home=Path.home(),
        )
        for path in matches:
            self.directory_suggestions.append(DirectorySuggestionRow(path))
        self.directory_suggestions_scroll.set_visible(bool(matches))
        self.directory_hint.set_text("No fuzzy matches — an exact existing path is still accepted.")
        self.directory_hint.set_visible(not matches and self.directory_entry.has_focus())
        if matches:
            self.directory_suggestions.select_row(self.directory_suggestions.get_row_at_index(0))

    def move_directory_suggestion(self, offset):
        rows = []
        child = self.directory_suggestions.get_first_child()
        while child:
            rows.append(child)
            child = child.get_next_sibling()
        if not rows:
            return
        selected = self.directory_suggestions.get_selected_row()
        index = rows.index(selected) if selected in rows else 0
        target = rows[max(0, min(len(rows) - 1, index + offset))]
        self.directory_suggestions.select_row(target)

    def select_directory_suggestion(self, row=None):
        row = row or self.directory_suggestions.get_selected_row()
        if not isinstance(row, DirectorySuggestionRow):
            return False
        self.directory_entry.set_text(row.path)
        self.directory_selected_path = row.path
        self.directory_suggestions_scroll.set_visible(False)
        self.directory_hint.set_text("Selected directory")
        self.directory_hint.set_visible(True)
        self.create_button.grab_focus()
        return True

    def activate_directory_entry(self):
        if self.directory_suggestions_scroll.get_visible() and self.select_directory_suggestion():
            return
        self.create_project()

    def create_project(self):
        try:
            raw_directory = self.directory_entry.get_text().strip()
            directory = str(Path(os.path.expanduser(raw_directory)).resolve(strict=False)) if raw_directory else raw_directory
            self.directory_entry.set_text(directory)
            project = backend.create_project(self.registry, self.name_entry.get_text(), directory)
            self.expanded_project_ids.add(project["id"])
            self.selected_scope = {"kind": "project", "projectId": project["id"]}
            self.save_picker_state()
            backend.enter_project(project, self.session, True)
        except Exception as error:
            self.create_error.set_text(str(error))
            self.create_error.set_visible(True)
            return
        self.dismiss_window()

    def install_actions(self):
        self.normal_actions = {}
        definitions = {
            "move-down": (lambda: self.move_selection(1), ["j", "Down"]),
            "move-up": (lambda: self.move_selection(-1), ["k", "Up"]),
            "search": (self.enter_search_mode, ["slash", "KP_Divide"]),
            "open": (self.open_selected, ["Return", "KP_Enter"]),
            "toggle-context": (self.toggle_context_inspector, ["space"]),
            "next-attention": (self.select_next_attention, ["n"]),
            "toggle-details": (self.toggle_context_details, ["d"]),
            "last": (lambda: self.select_edge(last=True), ["<Shift>g"]),
            "g-prefix": (self.handle_g, ["g"]),
        }
        for name, (callback, accelerators) in definitions.items():
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _action, _parameter, callback=callback: callback())
            self.add_action(action)
            self.set_accels_for_action(f"app.{name}", accelerators)
            self.normal_actions[name] = action

    def set_normal_actions_enabled(self, enabled):
        for action in self.normal_actions.values():
            action.set_enabled(enabled)

    def handle_g(self):
        if self.pending_g:
            self.select_edge(last=False)
            self.pending_g = False
        else:
            self.pending_g = True

    def dismiss_window(self):
        if self.persistent:
            self.window.hide()
        else:
            self.window.close()

    def on_close_request(self, _window):
        if not self.persistent:
            return False
        self.window.hide()
        return True

    def show_window(self, after_place=None):
        try:
            self.registry = backend.load_registry()
            self.session = backend.reconcile_session(self.registry, backend.load_session())
            self.current_workspace = backend.active_workspace_name()
            self.agent_activity = self.load_agent_activity()
            if hasattr(self, "listbox"):
                self.list_title.set_text("Projects")
                self.footer_hint.set_text(FOOTER_HINT)
                self.search.set_placeholder_text("Press / to search projects and streams…")
                self.refresh_rows()
        except Exception as error:
            backend.notify_error(str(error))
            return True
        self.start_hidden = False
        self.stack.set_visible_child_name("list")
        self.search.set_text("")
        self.focus_normal_mode()
        target_workspace = self.current_workspace
        self.window.present()

        def place_on_requested_workspace(attempt=0):
            try:
                if self.move_picker_to_workspace(target_workspace):
                    if after_place:
                        after_place()
                    return GLib.SOURCE_REMOVE
            except Exception as error:
                backend.notify_error(str(error))
                return GLib.SOURCE_REMOVE
            if attempt >= 10:
                backend.notify_error("The picker opened, but Hyprland did not expose its window in time")
                return GLib.SOURCE_REMOVE
            GLib.timeout_add(25, place_on_requested_workspace, attempt + 1)
            return GLib.SOURCE_REMOVE

        GLib.idle_add(place_on_requested_workspace)
        return True

    def on_key_pressed(self, _controller, keyval, _keycode, state):
        control = bool(state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        page = self.stack.get_visible_child_name()
        if page == "create" and self.directory_entry.has_focus():
            suggestions_visible = self.directory_suggestions_scroll.get_visible()
            if suggestions_visible and (keyval == Gdk.KEY_Down or (control and keyval == Gdk.KEY_j)):
                self.move_directory_suggestion(1)
                return True
            if suggestions_visible and (keyval == Gdk.KEY_Up or (control and keyval == Gdk.KEY_k)):
                self.move_directory_suggestion(-1)
                return True
            if suggestions_visible and keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.select_directory_suggestion()
                return True
            if suggestions_visible and keyval == Gdk.KEY_Escape:
                self.directory_suggestions_scroll.set_visible(False)
                return True
        if keyval == Gdk.KEY_Escape:
            if page in ("create", "create-stream"):
                self.show_list()
            elif self.search_mode:
                self.search.set_text("")
                self.focus_normal_mode()
            else:
                self.dismiss_window()
            return True
        if control and keyval in (Gdk.KEY_n, Gdk.KEY_N):
            if shift:
                self.show_create_stream()
            else:
                self.show_create()
            return True
        if self.stack.get_visible_child_name() != "list":
            return False

        if self.search_mode:
            if keyval == Gdk.KEY_Down or (control and keyval == Gdk.KEY_j):
                self.move_selection(1)
                return True
            if keyval == Gdk.KEY_Up or (control and keyval == Gdk.KEY_k):
                self.move_selection(-1)
                return True
            return False

        if self.is_next_attention_key(keyval, state):
            self.activate_action("next-attention", None)
            return True
        if keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            if shift or keyval == Gdk.KEY_ISO_Left_Tab:
                self.toggle_all_projects()
            else:
                self.toggle_selected_project()
            return True
        if keyval == Gdk.KEY_r:
            self.resume_stream_pi()
            return True
        if keyval == Gdk.KEY_x:
            self.request_close_workspace()
            return True
        if keyval == Gdk.KEY_a:
            self.request_archive_project()
            return True

        return False


def run_daemon(show_initially, close_active_workspace=False, next_attention=False, previous_attention=False):
    backend.ensure_directory(backend.RUNTIME_ROOT)
    pid_path = backend.RUNTIME_ROOT / "picker-gui.json"
    application = PickerApplication(persistent=True, start_hidden=not show_initially)
    application.register(None)
    application.activate()
    loop = GLib.MainLoop()

    def stop():
        loop.quit()
        return GLib.SOURCE_CONTINUE

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, application.show_window)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, application.request_close_active_workspace)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, application.jump_next_attention)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, application.jump_previous_attention)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    pid_path.write_text(json.dumps({"pid": os.getpid(), "command": str(Path(sys.argv[0]).resolve())}) + "\n")
    pid_path.chmod(0o600)
    if next_attention or previous_attention:
        def jump_once():
            if previous_attention:
                application.jump_previous_attention()
            else:
                application.jump_next_attention()
            return GLib.SOURCE_REMOVE

        GLib.idle_add(jump_once)
    if close_active_workspace:
        def close_active_once():
            application.request_close_active_workspace()
            return GLib.SOURCE_REMOVE

        GLib.idle_add(close_active_once)
    try:
        loop.run()
    finally:
        pid_path.unlink(missing_ok=True)


def main():
    if "--daemon" in sys.argv:
        run_daemon(
            show_initially="--show" in sys.argv,
            close_active_workspace="--close-active-workspace" in sys.argv,
            next_attention="--next-attention" in sys.argv,
            previous_attention="--previous-attention" in sys.argv,
        )
        return
    application = PickerApplication()
    raise SystemExit(application.run([sys.argv[0]]))


if __name__ == "__main__":
    main()
