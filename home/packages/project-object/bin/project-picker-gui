#!/usr/bin/env python3

import importlib.util
import json
from importlib.machinery import SourceFileLoader
import os
from pathlib import Path
import signal
import sys

SCRIPT_DIR = Path(__file__).resolve().parent
BACKEND_COMMAND = SCRIPT_DIR / "project-picker-tui"
PACKAGED_BACKEND_SOURCE = SCRIPT_DIR / ".project-picker-tui-wrapped"
BACKEND_SOURCE = PACKAGED_BACKEND_SOURCE if PACKAGED_BACKEND_SOURCE.exists() else BACKEND_COMMAND
loader = SourceFileLoader("project_picker_backend", str(BACKEND_SOURCE))
spec = importlib.util.spec_from_loader(loader.name, loader)
backend = importlib.util.module_from_spec(spec)
loader.exec_module(backend)

try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk
except (ImportError, ValueError) as error:
    print(f"Project picker: GTK interface unavailable: {error}", file=sys.stderr)
    os.execv(str(BACKEND_COMMAND), [str(BACKEND_COMMAND)])

APP_ID = "dev.project_object.Picker"

CSS = """
window { background: transparent; }
.picker-shell {
  background: #11131a;
  color: #eef1f8;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.10);
  box-shadow: 0 18px 50px rgba(0,0,0,0.45);
}
.header { padding: 24px 28px 14px; }
.title { font-size: 22px; font-weight: 750; letter-spacing: -0.3px; }
.shortcut { color: #8d93a5; font-size: 12px; }
.search { margin: 0 24px 14px; min-height: 46px; border-radius: 12px; font-size: 15px; }
.project-list { background: transparent; margin: 0 18px; }
.project-row { border-radius: 12px; margin: 2px 0; padding: 4px; background: transparent; }
.project-row:selected { background: #262b3a; }
.project-row:hover { background: rgba(255,255,255,0.045); }
.row-content { padding: 11px 13px; }
.project-dot { color: #676f86; font-size: 18px; min-width: 24px; }
.current-dot { color: #74d3ae; }
