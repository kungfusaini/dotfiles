#!/usr/bin/env python3

import json
import os
from pathlib import Path
import re
import secrets
import shlex
import subprocess
import sys
import time
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from agent_browser import app_launch_matches, ascii_uri, validate as validate_browser_launch  # noqa: E402

HYPRCTL = os.environ.get("PROJECT_PICKER_HYPRCTL", "hyprctl")
WORKSPACE_ENV = "PROJECT_OBJECT_WORKSPACE_NAME"
LAUNCH_WORKSPACE_ENV = "PROJECT_OBJECT_LAUNCH_WORKSPACE_NAME"
LAUNCH_ID_ENV = "PROJECT_OBJECT_LAUNCH_ID"
WINDOW_TIMEOUT = 15.0
ADDRESS_PATTERN = re.compile(r"0x[0-9a-fA-F]+")


def hypr_clients():
    result = subprocess.run(
        [HYPRCTL, "clients", "-j"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit status {result.returncode}"
        raise RuntimeError(f"hyprctl clients failed: {detail}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("hyprctl clients returned invalid JSON") from error
    if not isinstance(value, list):
        raise RuntimeError("hyprctl clients did not return a list")
    return value


def parent_pid(pid):
    try:
        value = (Path("/proc") / str(pid) / "stat").read_text()
        closing = value.rfind(")")
        if closing < 0:
            return None
        fields = value[closing + 2:].split()
        return int(fields[1]) if len(fields) > 1 else None
    except (OSError, ValueError):
        return None


def ancestor_pids():
    result = []
    pid = os.getpid()
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        result.append(pid)
        parent = parent_pid(pid)
        if parent is None:
            break
        pid = parent
    return result


def client_workspace(client):
    if not isinstance(client, dict):
        return None
    workspace = client.get("workspace")
    if not isinstance(workspace, dict):
        return None
    name = workspace.get("name")
    return name if isinstance(name, str) and name else None


def invoking_workspace(clients):
    by_pid = {}
    for client in clients:
        if isinstance(client, dict) and isinstance(client.get("pid"), int):
            workspace = client_workspace(client)
            if workspace:
                by_pid.setdefault(client["pid"], set()).add(workspace)
    for pid in ancestor_pids():
        workspaces = by_pid.get(pid, set())
        if len(workspaces) == 1:
            return next(iter(workspaces))
        if workspaces:
            # A single terminal server can own windows on several workspaces.
            # Do not pick the first client in compositor enumeration order.
            break
    fallback = os.environ.get(WORKSPACE_ENV, "")
    return fallback if fallback else None


def validate_workspace_rule(name):
    if any(character in name for character in ";[],\r\n\0"):
        raise RuntimeError(f"workspace name cannot be represented safely in a Hyprland exec rule: {name!r}")


def process_has_launch_id(pid, launch_id):
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    marker = f"{LAUNCH_ID_ENV}={launch_id}".encode()
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            environment = (Path("/proc") / str(pid) / "environ").read_bytes().split(b"\0")
            if marker in environment:
                return True
        except OSError:
            # Sandboxed Chromium may make its own environ unreadable. The
            # waiting Python/shell launcher still identifies its descendants.
            pass
        pid = parent_pid(pid)
        if pid is None:
            break
    return False


def verify_window(workspace, launch_id, before):
    deadline = time.monotonic() + WINDOW_TIMEOUT
    selected_address = None
    while time.monotonic() < deadline:
        for client in hypr_clients():
            if not isinstance(client, dict) or not client.get("mapped"):
                continue
            address = client.get("address")
            if not isinstance(address, str) or not ADDRESS_PATTERN.fullmatch(address) or address in before:
                continue
            if selected_address is not None and address != selected_address:
                continue
            if selected_address is None and not (app_launch_matches(client, launch_id)
                                                 or process_has_launch_id(client.get("pid"), launch_id)):
                continue
            selected_address = address
            if client_workspace(client) != workspace:
                result = subprocess.run(
                    [HYPRCTL, "dispatch", "movetoworkspacesilent", f"name:{workspace},address:{address}"],
                    capture_output=True, text=True, check=False,
                )
                if result.returncode != 0 or result.stdout.strip() != "ok":
                    raise RuntimeError("could not silently place the launched window")
                # Re-read this exact window, not a second window from the
                # same launch that may already be on the requested workspace.
                break
            return
        time.sleep(0.05)
    raise RuntimeError(
        "no new window could be verified on the invoking workspace within 15 seconds; "
        "the application may still be running (existing-instance handoffs and "
        "applications that discard the launch environment cannot be verified)"
    )


def steam_backend_pids(launch_id):
    """Verify a new real client, not its updater UI or an unrelated process."""
    found = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            argv = (entry / "cmdline").read_bytes().split(b"\0")
            if not argv[0].endswith(b"/ubuntu12_32/steam") or b"-child-update-ui" in argv:
                continue
            marker = f"{LAUNCH_ID_ENV}={launch_id}".encode()
            if marker in (entry / "environ").read_bytes().split(b"\0"):
                found.append(int(entry.name))
        except OSError:
            pass
    return found


def steam_hide_rule():
    # Named Steam-only policy stays enabled for delayed updater/login windows.
    # Disable while configuring so an incomplete rule can never match all apps.
    rule = "windowrule[project-object-steam-hidden]"
    effects = (("enable", "0"), ("match:class", "^([Ss]team)$"),
               ("workspace", "special:steam-hidden silent"),
               ("no_initial_focus", "on"), ("suppress_event", "activate activatefocus"),
               ("enable", "1"))
    for key, value in effects:
        result = subprocess.run([HYPRCTL, "keyword", rule + ":" + key, value],
                                capture_output=True, text=True, check=False)
        if result.returncode or result.stdout.strip() != "ok":
            raise RuntimeError("could not install the Steam-only hidden-window policy")


def verify_steam_backend(launch_id):
    deadline = time.monotonic() + WINDOW_TIMEOUT
    while time.monotonic() < deadline:
        if steam_backend_pids(launch_id):
            for client in hypr_clients():
                if (isinstance(client, dict) and client.get("mapped")
                        and str(client.get("class", "")).lower() == "steam"
                        and process_has_launch_id(client.get("pid"), launch_id)
                        and client_workspace(client) != "special:steam-hidden"):
                    raise RuntimeError("Steam created a window outside its hidden workspace")
            return  # A tray-only client is expected to have no mapped window.
        time.sleep(0.05)
    raise RuntimeError("no newly launched Steam client process could be verified")


def steam_game_process(pid, appid):
    """Match the requested game through live process ancestry, not its title."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    markers = {f"SteamAppId={appid}".encode(), f"SteamGameId={appid}".encode()}
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            values = set((Path("/proc") / str(pid) / "environ").read_bytes().split(b"\0"))
            if markers & values:
                return True
        except OSError:
            pass
        pid = parent_pid(pid)
        if pid is None:
            break
    return False


def verify_steam_game(workspace, appid, before):
    deadline = time.monotonic() + 180
    selected = None
    while time.monotonic() < deadline:
        clients = hypr_clients()
        if selected is not None:
            current = next((c for c in clients if isinstance(c, dict)
                            and c.get("address") == selected and c.get("mapped")), None)
            if (current is None or str(current.get("class", "")).lower() == "steam"
                    or not steam_game_process(current.get("pid"), appid)):
                # Splash/launcher windows may vanish before revalidation. A
                # replacement still needs exact live app identity; never guess.
                selected = None
        for client in clients:
            if not isinstance(client, dict) or not client.get("mapped"):
                continue
            address = client.get("address")
            if not isinstance(address, str) or not ADDRESS_PATTERN.fullmatch(address) or address in before:
                continue
            if str(client.get("class", "")).lower() == "steam":
                continue  # Login, settings and confirmation dialogs stay hidden.
            if selected is not None and address != selected:
                continue
            # Revalidate process identity even after selecting the exact window.
            if not steam_game_process(client.get("pid"), appid):
                continue
            selected = address
            if client_workspace(client) != workspace:
                result = subprocess.run(
                    [HYPRCTL, "dispatch", "movetoworkspacesilent", f"name:{workspace},address:{address}"],
                    capture_output=True, text=True, check=False)
                if result.returncode or result.stdout.strip() != "ok":
                    raise RuntimeError("could not silently place the verified Steam game window")
                break
            return
        time.sleep(0.05)
    raise RuntimeError("no new window belonging to the requested Steam game could be verified")


def raw_browser_urls(command):
    """Accept only URL opens; never pass arbitrary flags to the shared browser."""
    arguments = command[1:]
    if arguments[:1] == ["--new-window"]:
        arguments = arguments[1:]
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    if not arguments or any(argument.startswith("-") for argument in arguments):
        raise RuntimeError(
            "unsupported Vivaldi launch; use project-workspace-exec project-browser open URL [URL ...] "
            "(raw Vivaldi accepts only optional --new-window, optional --, and HTTP(S) URLs)"
        )
    return arguments


def main():
    command = sys.argv[1:]
    if command in (["--help"], ["-h"]):
        print("usage: project-workspace-exec COMMAND [ARG ...]")
        return
    if not command:
        raise SystemExit("usage: project-workspace-exec COMMAND [ARG ...]")
    try:
        clients = hypr_clients()
        workspace = invoking_workspace(clients)
        if not workspace:
            raise RuntimeError("could not identify the Hyprland workspace containing the invoking terminal")
        validate_workspace_rule(workspace)
        before = {client.get("address") for client in clients if isinstance(client, dict)}
        launch_id = secrets.token_hex(16)
        browser_executable = None
        steam_background = Path(command[0]).name == "steam" and command[1:] == ["-silent"]
        steam_game = (re.fullmatch(r"steam://rungameid/([1-9][0-9]*)", command[1])
                      if Path(command[0]).name == "steam" and len(command) == 2 else None)
        if steam_background or steam_game:
            steam_hide_rule()
        if Path(command[0]).name in ("vivaldi", "vivaldi-stable"):
            urls = raw_browser_urls(command)
            validate_browser_launch(workspace, urls, launch_id)
            urls = [ascii_uri(url) for url in urls]
            # urllib's parser/IDNA codec are not hostname validators: they
            # preserve spaces, escapes and other forbidden browser host bytes.
            # Accept plain DNS/IP hosts only (IPv6 is checked by urlsplit).
            if any(not re.fullmatch(r"[A-Za-z0-9_.:-]+", urlsplit(url).hostname or "") for url in urls):
                raise ValueError("Raw Vivaldi URLs require a plain DNS or IP hostname")
            browser_executable = command[0]
            # Use the sibling router from this package, not an older PATH copy.
            command = [str(Path(__file__).resolve().with_name("project-browser")), "open", *urls]
        if Path(command[0]).name in ("project-browser", ".project-browser-wrapped"):
            # The browser has its own exact app-id rule and verifies every URL.
            # Do not add competing exec rules or a second new-process verifier.
            environment = {**os.environ, LAUNCH_WORKSPACE_ENV: workspace, LAUNCH_ID_ENV: launch_id}
            environment.setdefault("PROJECT_BROWSER_HYPRCTL", HYPRCTL)
            if browser_executable is not None:
                environment.setdefault("PROJECT_BROWSER_VIVALDI", browser_executable)
            result = subprocess.run(command, env=environment, check=False)
            if result.returncode:
                raise SystemExit(result.returncode)
            print(f"project-workspace-exec: verified browser launch on {workspace}")
            return
        # Hyprland's exec inherits compositor env, not this terminal's env.
        # Keep the invoking Pi browser owner even through Python/shell launchers;
        # forward only identity/path metadata, never the complete environment.
        context = [f"{name}={os.environ[name]}" for name in
                   ("PI_SESSION_ID", "PI_SESSION_FILE", "XDG_STATE_HOME") if name in os.environ]
        contextual_command = ["env", "--chdir=" + os.getcwd(),
                              f"{LAUNCH_WORKSPACE_ENV}={workspace}", f"{LAUNCH_ID_ENV}={launch_id}",
                              *context, *command]
        # Steam's client and descendants begin hidden. The game URI branch below
        # promotes only a window whose live process belongs to the exact app ID.
        target = "special:steam-hidden" if steam_background else "name:" + workspace
        payload = f"[workspace {target} silent] {shlex.join(contextual_command)}"
        result = subprocess.run([HYPRCTL, "dispatch", "exec", payload], capture_output=True, text=True, check=False)
        if result.returncode != 0 or result.stdout.strip() != "ok":
            raise RuntimeError("Hyprland refused to launch the command")
        if steam_background:
            verify_steam_backend(launch_id)
            print("project-workspace-exec: verified silent Steam process; client windows stay hidden")
        elif steam_game:
            verify_steam_game(workspace, int(steam_game[1]), before)
            print(f"project-workspace-exec: verified Steam game {steam_game[1]} on {workspace}")
        else:
            verify_window(workspace, launch_id, before)
            print(f"project-workspace-exec: verified new window on {workspace}")
    except (OSError, RuntimeError, ValueError) as error:
        raise SystemExit(f"project-workspace-exec: {error}") from error


if __name__ == "__main__":
    main()
