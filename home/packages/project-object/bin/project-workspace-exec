#!/usr/bin/env python3

import json
import os
from pathlib import Path
import shlex
import subprocess
import sys

HYPRCTL = os.environ.get("PROJECT_PICKER_HYPRCTL", "hyprctl")
WORKSPACE_ENV = "PROJECT_OBJECT_WORKSPACE_NAME"
LAUNCH_WORKSPACE_ENV = "PROJECT_OBJECT_LAUNCH_WORKSPACE_NAME"


def hypr_clients():
    result = subprocess.run(
        [HYPRCTL, "clients", "-j"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit status {result.returncode}"
        raise RuntimeError(f"hyprctl clients failed: {detail}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("hyprctl clients returned invalid JSON") from error
    if not isinstance(value, list):
        raise RuntimeError("hyprctl clients did not return a list")
    return value


def parent_pid(pid):
    try:
        value = (Path("/proc") / str(pid) / "stat").read_text()
        closing = value.rfind(")")
        if closing < 0:
            return None
        fields = value[closing + 2:].split()
        return int(fields[1]) if len(fields) > 1 else None
    except (OSError, ValueError):
        return None


def ancestor_pids():
    result = []
    pid = os.getpid()
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        result.append(pid)
        parent = parent_pid(pid)
        if parent is None:
            break
        pid = parent
    return result


def client_workspace(client):
    if not isinstance(client, dict):
        return None
    workspace = client.get("workspace")
    if not isinstance(workspace, dict):
        return None
    name = workspace.get("name")
    return name if isinstance(name, str) and name else None


def invoking_workspace(clients):
    by_pid = {}
    for client in clients:
        if isinstance(client, dict) and isinstance(client.get("pid"), int):
            workspace = client_workspace(client)
            if workspace:
                by_pid.setdefault(client["pid"], workspace)
    for pid in ancestor_pids():
        if pid in by_pid:
            return by_pid[pid]
    fallback = os.environ.get(WORKSPACE_ENV, "")
    return fallback if fallback else None


def validate_workspace_rule(name):
    if any(character in name for character in ";[]\r\n"):
        raise RuntimeError(f"workspace name cannot be represented safely in a Hyprland exec rule: {name!r}")


def main():
    command = sys.argv[1:]
    if not command:
        raise SystemExit("usage: project-workspace-exec COMMAND [ARG ...]")
    try:
        workspace = invoking_workspace(hypr_clients())
        if not workspace:
            raise RuntimeError("could not identify the Hyprland workspace containing the invoking terminal")
        validate_workspace_rule(workspace)
        contextual_command = ["env", f"{LAUNCH_WORKSPACE_ENV}={workspace}", *command]
        payload = f"[workspace name:{workspace} silent] {shlex.join(contextual_command)}"
        result = subprocess.run([HYPRCTL, "dispatch", "exec", payload], check=False)
        if result.returncode != 0:
            raise RuntimeError(f"Hyprland refused to launch the command (exit status {result.returncode})")
    except RuntimeError as error:
        raise SystemExit(f"project-workspace-exec: {error}") from error


if __name__ == "__main__":
    main()
