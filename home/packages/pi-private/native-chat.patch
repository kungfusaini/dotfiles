+// Private variant: sanitize history at ingestion so EVERY native history view
+// (tree, session list, branch previews and resumed transcript) receives safe text.
+function privateHistoryText<T>(value: T): T {
+	if (typeof value === "string") return value.replace(/[\u0000-\u0008\u000b-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/g, "") as T;
+	if (Array.isArray(value)) return value.map((item) => privateHistoryText(item)) as T;
+	if (value && typeof value === "object") {
+		return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, privateHistoryText(item)])) as T;
+	}
+	return value;
