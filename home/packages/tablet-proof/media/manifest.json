{
  "manifest_version": 3,
  "name": "Tablet media companion",
  "version": "0.2.0",
  "description": "Pause web audio/video only in the registered tablet window.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Pair this tablet window for media pause"},
  "options_ui": {"page": "pair.html", "open_in_tab": true},
  "content_scripts": [
    {"matches": ["http://tablet.localhost/register/*"], "js": ["register.js"], "run_at": "document_end"},
    {"matches": ["http://*/*", "https://*/*"], "js": ["media.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true}
  ]
}
