{
  "manifest_version": 3,
  "name": "Tablet media companion",
  "version": "0.1.0",
  "description": "Pause YouTube media only in the registered tablet window.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*", "http://tablet.localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Pair this tablet window for media pause"},
  "options_ui": {"page": "pair.html", "open_in_tab": true},
  "content_scripts": [
    {"matches": ["http://tablet.localhost/register/*"], "js": ["register.js"], "run_at": "document_end"},
    {"matches": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"], "js": ["media.js"], "run_at": "document_start", "all_frames": true}
  ]
}
