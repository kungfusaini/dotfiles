+static void
+nd_window_close_session (NdWindow *self)
+{
+  XdpSession *session = g_steal_pointer (&self->session);
+
+  if (session)
+    {
+      xdp_session_close (session);
+      g_object_unref (session);
+    }
+}
+
+static void
+nd_window_clear_pending_sink (NdWindow *self)
+{
+  g_clear_object (&self->pending_sink);
+  if (!self->closing)
+    gtk_widget_set_sensitive (GTK_WIDGET (self->find_sink_list), TRUE);
+}
+
+static gboolean
+nd_window_close_requested_cb (NdWindow *self)
+{
+  if (self->closing)
+    return FALSE;
+
+  self->closing = TRUE;
+  g_cancellable_cancel (self->cancellable);
+  nd_window_clear_pending_sink (self);
+  nd_window_close_session (self);
+  if (self->stream_sink)
+    nd_sink_stop_stream (self->stream_sink);
+  return FALSE;
+}
 
