set -u

runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
control=/run/current-system/sw/bin/headless-mode-control
sudo=/run/wrappers/bin/sudo
socket="$runtime/hypr/${HYPRLAND_INSTANCE_SIGNATURE:?}/.socket2.sock"
mkdir -p "$runtime/headless-mode"
printf '%s\n' "$$" > "$runtime/headless-mode/watcher.pid"
trap 'rm -f "$runtime/headless-mode/watcher.pid"' EXIT

known_outputs=()
refresh_outputs() {
  local outputs
  outputs=$(hyprctl monitors all -j | python3 -c '
import json, sys
print("\n".join(m["name"] for m in json.load(sys.stdin)))
') || return 0
  mapfile -t known_outputs <<< "$outputs"
}

monitor_added() {
  local name=$1 known is_new=1
  for known in "${known_outputs[@]}"; do
    [[ $known != "$name" ]] || is_new=0
  done
  check_recovery
  # Enabling an existing panel or unmirroring an existing external screen also
  # emits monitoradded. Only a genuinely new physical output should reapply
  # Shift-F7's saved layout, even if events queued until restoration completed.
  if (( is_new )) && [[ $name != eDP-1 && $name != clamshell-recovery-* ]]; then
    apply_saved_layout
  fi
  refresh_outputs
}

external_active() {
  hyprctl monitors all -j | python3 -c '
import json, sys
raise SystemExit(not any(m.get("name") != "eDP-1" and not m.get("disabled", False) for m in json.load(sys.stdin)))
' 2>/dev/null
}

apply_saved_layout() {
  # The lid controller owns its saved layout until reopening/recovery.
  [[ ! -e "$runtime/clamshell-mode/state.json" ]] || return 0
  local state_file=${XDG_STATE_HOME:-$HOME/.local/state}/external-display-position
  [[ -r "$state_file" && -r /run/headless-mode/state ]] || return 0
  [[ $(</run/headless-mode/state) == off ]] || return 0
  # Only extend an actual two-monitor desktop. Headless restoration has its
  # own layout path, and mirroring must not silently become extended.
  if ! hyprctl monitors all -j | python3 -c '
import json, sys
ms=json.load(sys.stdin)
i=next((m for m in ms if m.get("name")=="eDP-1" and not m.get("disabled",False)),None)
e=next((m for m in ms if m.get("name")!="eDP-1" and not m.get("disabled",False)),None)
raise SystemExit(not (i and e and e.get("mirrorOf","none")=="none"))
' 2>/dev/null; then return 0; fi
  local dx dy _
  read -r dx dy _ < "$state_file" || return 0
  [[ $dx =~ ^-?[0-9]+$ && $dy =~ ^-?[0-9]+$ ]] || return 0
  DISPLAY_LAYOUT_SILENT=1 display-layout-apply custom "$dx" "$dy" 1 \
    >>"$runtime/headless-layout.log" 2>&1 || true
}

check_recovery() {
  if [[ -e "$runtime/clamshell-mode/state.json" ]]; then
    clamshell-mode check >>"$runtime/clamshell-mode/recovery.log" 2>&1 || true
  fi
  local state
  state=off
  if [[ -r /run/headless-mode/state ]]; then
    state=$(</run/headless-mode/state)
  fi
  if [[ $state == active || $state == primed || $state == priming ]]; then
    if ! external_active || { [[ $state == active ]] && ! timeout 8 "$sudo" -n "$control" probe-external; }; then
      printf '%s External monitor lost; requesting emergency restoration\n' "$(date --iso-8601=seconds)" >> "$runtime/headless-monitor-watch.log"
      # A hotplug burst may deliver multiple events before ISH reload finishes.
      # Never queue another restore (or another notification) behind the first.
      nohup flock -n "$runtime/headless-mode/emergency.lock" headless-mode restore \
        >>"$runtime/headless-emergency-restore.log" 2>&1 </dev/null &
    elif [[ $state == active ]]; then
      # A config reload can re-enable the internal panel without changing the
      # separate root controller state. Reconcile under the transition lock;
      # the helper rechecks state and never disables our only usable output.
      headless-mode reconcile >>"$runtime/headless-reconcile.log" 2>&1 || true
    fi
  fi
}

# Track connected outputs (including disabled/mirrored ones) before recovery
# generates any compositor enable events.
refresh_outputs
# Recover stale/open-lid clamshell state before applying any saved layout.
# A current-session recovery already owns the startup layout; it may remove its
# journal, so remember that ownership before calling it.
startup_clamshell=$(python3 -c '
import json, pathlib, sys
try:
    state=json.loads(pathlib.Path(sys.argv[1]).read_text())
    print(int(state.get("instance") == sys.argv[2]))
except (OSError, ValueError):
    print(0)
' "$runtime/clamshell-mode/state.json" "$HYPRLAND_INSTANCE_SIGNATURE")
check_recovery
# Restore the Shift-F7 layout only for a normal session startup.
if [[ $startup_clamshell != 1 ]]; then apply_saved_layout; fi

# Socket events provide immediate restoration. While active, a bounded DRM
# detect probe also catches a disconnected sink whose Type-C adapter remains
# attached and whose connector is incorrectly reported as still connected.
while true; do
  if [[ -S "$socket" ]]; then
    while IFS= read -r event; do
      case "$event" in
        configreloaded\>\>*) check_recovery ;;
        monitorremoved\>\>*) check_recovery; refresh_outputs ;;
        monitoradded\>\>*) monitor_added "${event#*>>}" ;;
      esac
    done < <(socat -T 2 -u "UNIX-CONNECT:$socket" - 2>/dev/null)
  fi
  check_recovery
  sleep 1
done
