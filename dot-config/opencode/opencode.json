{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "normal",
  "enabled_providers": [
    "opencode",
    "openai"
  ],
  "plugin": [
    "@mohak34/opencode-notifier@0.2.5"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path",
        "/Applications/Nix Apps/Brave Browser.app/Contents/MacOS/Brave Browser"
      ]
    }
  },
  "agent": {
    "build": {
      "disable": true
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 4000
  }
}
