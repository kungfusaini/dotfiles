{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "nanogpt",
    "opencodezen"
  ],
  "provider": {
    "nanogpt": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NanoGPT",
      "options": {
        "baseURL": "https://nano-gpt.com/api/v1"
      },
      "models": {
        "moonshotai/kimi-k2.5:thinking": {
          "name": "Kimi K2.5 Thinking",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "deepseek/deepseek-v3.2": {
          "name": "DeepSeek V3.2",
          "limit": {
            "context": 163000,
            "output": 65500
          }
        },
        "zai-org/glm-4.7:thinking": {
          "name": "GLM 4.7 Thinking",
          "limit": {
            "context": 200000,
            "output": 65500
          }
        },
        "arcee-ai/trinity-large": {
          "name": "Trinity Large",
          "limit": {
            "context": 131100,
            "output": 65500
          }
        },
        "openai/gpt-oss-120b": {
          "name": "Speed Demon (GPT OSS 120B)",
          "limit": {
            "context": 128000,
            "output": 16400
          }
        },
        "nousresearch/hermes-4-70b": {
          "name": "Hermes 4 70B",
          "limit": {
            "context": 128000,
            "output": 8200
          }
        },
        "qwen3-vl-235b-a22b-thinking": {
          "name": "Qwen 3 VL Thinking",
          "limit": {
            "context": 32000,
            "output": 32000
          }
        },
        "mistralai/mistral-large-3-675b-instruct-2512": {
          "name": "Mistral Large 3 Instruct",
          "limit": {
            "context": 262100,
            "output": 256000
          }
        }
      }
    },
    "opencodezen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle",
          "limit": {
            "context": 32000,
            "output": 8000
          }
        },
        "gpt-5-nano": {
          "name": "GPT 5 Nano",
        }
      }
    }
  },
  "plugin": ["notify"]
}
