{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "normal",
  "small_model": "opencode/big-pickle",
  "enabled_providers": [
    "opencode",
    "openai",
    "litellm"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "native-router": {
          "name": "native-router",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "model-router": {
          "name": "model-router",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@0.2.5",
    "@kungfusaini/opencode-projects"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path",
        "/Applications/Nix Apps/Brave Browser.app/Contents/MacOS/Brave Browser"
      ]
    }
  },
  "agent": {
    "build": {
      "disable": true
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 4000
  }
}
