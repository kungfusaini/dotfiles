[
  {
    "plugin_id": "sumeet.pi-workspace-sync",
    "name": "Pi Workspace Sync",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Durably reconcile Herdr spaces with Pi projects through a shared XDG registry.",
    "manifest_path": "/Users/sumeet/.dotfiles/dot-config/herdr/plugins/pi-workspace-sync/herdr-plugin.toml",
    "plugin_root": "/Users/sumeet/.dotfiles/dot-config/herdr/plugins/pi-workspace-sync",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "startup": [
      {
        "command": [
          "node",
          "sync.mjs",
          "startup"
        ]
      }
    ],
    "actions": [
      {
        "id": "sync",
        "title": "Sync Pi projects and Herdr spaces",
        "contexts": [
          "workspace"
        ],
        "command": [
          "node",
          "sync.mjs",
          "action"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.closed",
        "command": [
          "node",
          "sync.mjs",
          "event"
        ]
      },
      {
        "on": "tab.closed",
        "command": [
          "node",
          "sync.mjs",
          "event"
        ]
      },
      {
        "on": "tab.created",
        "command": [
          "node",
          "sync.mjs",
          "event"
        ]
      },
      {
        "on": "tab.focused",
        "command": [
          "node",
          "sync.mjs",
          "event"
        ]
      },
      {
        "on": "tab.renamed",
        "command": [
          "node",
          "sync.mjs",
          "event"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]