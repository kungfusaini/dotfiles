{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
          "command": "$HOME/.config/claude/bin/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
          "command": "$HOME/.config/claude/bin/notify.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "editorMode": "vim",
  "voiceEnabled": true,
  "skipAutoPermissionPrompt": true
}
