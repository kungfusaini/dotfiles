#!/bin/bash

# pyproj - Create a new Python project with modular environment setup
# Usage: pyproj <project-name>
# Author: Generated for Sumeet's development workflow

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

print_step() {
    echo -e "${YELLOW}▸ $1${NC}"
}

# Function to check if required tools are available
check_dependencies() {
    local deps=("git" "python" "direnv" "nix")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            print_error "Required dependency '$dep' is not installed"
            return 1
        fi
    done
    print_success "All dependencies are available"
}

# Function to validate project name
validate_project_name() {
    local name="$1"
    if [[ -z "$name" ]]; then
        print_error "Project name is required"
        echo "Usage: pyproj <project-name>"
        return 1
    fi
    
    if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        print_error "Project name can only contain letters, numbers, hyphens, and underscores"
        return 1
    fi
    
    if [[ -d "$name" ]]; then
        print_error "Directory '$name' already exists"
        return 1
    fi
    
    print_success "Project name '$name' is valid"
}

# Function to create flake.nix
create_flake_nix() {
    local project_name="$1"
    cat > flake.nix << EOF
{
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
  inputs.flake-utils.url = "github:numtide/flake-utils";

  outputs =
    {
      self,
      nixpkgs,
      flake-utils,
    }:
    flake-utils.lib.eachDefaultSystem (
      system:
      let
        pkgs = nixpkgs.legacyPackages.\${system};
      in
      {
        devShells.default = pkgs.mkShell {
          packages = with pkgs; [
            python3
            python3Packages.pip
            git
          ];
        };
      }
    );
}
EOF
    print_success "Created flake.nix"
}

# Function to create .envrc
create_envrc() {
    local project_name="$1"
    cat > .envrc << EOF
use flake
source .$project_name/bin/activate
dotenv
EOF
    print_success "Created .envrc"
}

# Function to create .gitignore
create_gitignore() {
    local project_name="$1"
    cat > .gitignore << EOF
.$project_name/
.env
EOF
    print_success "Created .gitignore"
}

# Function to create requirements.txt
create_requirements_txt() {
    touch requirements.txt
    print_success "Created requirements.txt (empty)"
}

# Function to create .env file
create_env_file() {
    touch .env
    print_success "Created .env (empty)"
}

# Main function
main() {
    local project_name="$1"
    
    print_info "Starting Python project setup for '$project_name'"
    
    # Step 1: Check dependencies
    print_step "Checking dependencies..."
    check_dependencies
    
    # Step 2: Validate project name
    print_step "Validating project name..."
    validate_project_name "$project_name"
    
    # Step 3: Create project directory
    print_step "Creating project directory..."
    mkdir -p "$project_name"
    cd "$project_name"
    print_success "Created directory '$project_name'"
    
    # Step 4: Initialize git repository
    print_step "Initializing git repository..."
    git init -q
    print_success "Initialized git repository"
    
    # Step 5: Create project files
    print_step "Creating project configuration files..."
    
    create_flake_nix "$project_name"
    create_envrc "$project_name"
    create_gitignore "$project_name"
    create_requirements_txt
    create_env_file
    
    # Step 6: Create Python virtual environment
    print_step "Creating Python virtual environment..."
    python -m venv ".$project_name"
    print_success "Created virtual environment '.$project_name'"
    
    # Step 7: Allow direnv
    print_step "Setting up direnv..."
    direnv allow
    print_success "Direnv is now active"
    
    # Step 8: Initial git commit
    print_step "Creating initial git commit..."
    git add .
    git commit -m "Initial commit: Set up Python project environment"
    print_success "Created initial git commit"
    
    # Step 9: Show final message
    echo
    print_success "🎉 Python project '$project_name' created successfully!"
    echo
    print_info "Next steps:"
    echo "  cd $project_name          # Enter project directory"
    echo "  pip install <package>     # Install Python packages"
    echo "  pip freeze > requirements.txt  # Update requirements.txt when ready"
    echo "  direnv allow               # Reload .envrc if needed"
    echo
    print_info "Project structure:"
    echo "  $project_name/"
    echo "  ├── .$project_name/       # Python virtual environment"
    echo "  ├── .envrc                 # Direnv configuration"
    echo "  ├── .gitignore             # Git ignore rules"
    echo "  ├── flake.nix              # Nix flake for system dependencies"
    echo "  └── requirements.txt       # Python dependencies (empty)"
    echo
}

# Run main function with all arguments
main "$@"