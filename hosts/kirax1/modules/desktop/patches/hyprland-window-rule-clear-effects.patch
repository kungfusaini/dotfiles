+// Explicitly clear a disabled rule instead of accumulating effects on each
+// update. Existing hl.window_rule semantics remain unchanged.
+static int windowRuleClearEffects(lua_State* L) {
+    auto* ref = sc<WP<Desktop::Rule::CWindowRule>*>(luaL_checkudata(L, 1, MT));
+    const auto rule = ref->lock();
+    if (!rule)
+        return luaL_error(L, "clear_effects: expired window rule");
+    if (rule->isEnabled())
+        return luaL_error(L, "clear_effects: disable the rule before clearing effects");
+
+    const auto count = rule->effects().size();
+    rule->clearEffects();
+    lua_pushinteger(L, count);
+    return 1;
+}
