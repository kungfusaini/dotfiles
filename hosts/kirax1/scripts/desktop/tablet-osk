#!/usr/bin/env bash
set -euo pipefail

RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}
DISABLED_FILE=${DISABLED_FILE:-$RUNTIME_DIR/tablet-osk-disabled}
LOG_FILE=${LOG_FILE:-$STATE_DIR/tablet-osk.log}

WVKBD_ARGS=(
  -L 300
  --alpha 235
  --bg 151515
  --fg 2b2b2b
  --fg-sp 3a3a3a
  --press 5a5a5a
  --press-sp 666666
  --text f2f2f2
  --text-sp f2f2f2
)

mkdir -p "$STATE_DIR"

osk_command() {
  if command -v wvkbd-mobintl >/dev/null 2>&1; then
    printf '%s\n' wvkbd-mobintl
  elif command -v wvkbd >/dev/null 2>&1; then
    printf '%s\n' wvkbd
  else
    return 1
  fi
}

osk_running() {
  pgrep -x wvkbd-mobintl >/dev/null 2>&1 || pgrep -x wvkbd >/dev/null 2>&1
}

start_osk() {
  local osk
  osk=$(osk_command) || {
    echo "tablet-osk: wvkbd is not installed" >&2
    notify-send "On-screen keyboard" "wvkbd is not installed" 2>/dev/null || true
    return 1
  }

  if ! osk_running; then
    "$osk" "${WVKBD_ARGS[@]}" >>"$LOG_FILE" 2>&1 &
  fi
}

stop_osk() {
  pkill -x wvkbd-mobintl >/dev/null 2>&1 || true
  pkill -x wvkbd >/dev/null 2>&1 || true
}

hide_osk() {
  touch "$DISABLED_FILE"
  stop_osk

  # Best-effort blur/unselect for the text field that summoned typing.
  sleep 0.05
  if command -v wtype >/dev/null 2>&1; then
    wtype -k Escape >/dev/null 2>&1 || true
  fi
}

toggle_osk() {
  if osk_running; then
    hide_osk
    exit 0
  fi

  rm -f "$DISABLED_FILE"
  start_osk
}

# Folding is owned by tablet-workspace watch, not a second keyboard policy.
case "${1:-toggle}" in
  toggle|--toggle) toggle_osk ;;
  hide|--hide) hide_osk ;;
  dismiss) touch "$DISABLED_FILE"; stop_osk ;;
  show|--show) rm -f "$DISABLED_FILE"; start_osk ;;
  *)
    printf 'Usage: %s [toggle|hide|show|dismiss]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
