#!/usr/bin/env bash
set -euo pipefail

signal_waybar() {
  pkill -RTMIN+10 waybar 2>/dev/null || true
}

json_escape() {
  sed ':a;N;$!ba;s/\\/\\\\/g;s/"/\\"/g;s/\n/\\n/g'
}

current_name() {
  wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null \
    | awk -F'= ' '/node.name/ { gsub(/^[[:space:]]*\*?[[:space:]]*/, "", $1); gsub(/"/, "", $2); print $2; exit }'
}

find_node_id() {
  local target=${1:?}
  local line id name

  while IFS= read -r line; do
    if [[ $line =~ ([0-9]+)\.\ ([^[:space:]]+) ]]; then
      id=${BASH_REMATCH[1]}
      name=${BASH_REMATCH[2]}

      case "$target" in
        laptop)
          if [[ $name == alsa_input.*Mic* || $name == alsa_input.*mic* ]]; then
            printf '%s\n' "$id"
            return 0
          fi
          ;;
        headset)
          if [[ $name == bluez_input.* ]]; then
            printf '%s\n' "$id"
            return 0
          fi
          ;;
      esac
    fi
  done < <(wpctl status --name 2>/dev/null)

  return 1
}

set_source() {
  local target=${1:?}
  local id

  id=$(find_node_id "$target") || {
    notify-send "Microphone source" "Could not find $target microphone" 2>/dev/null || true
    exit 1
  }

  wpctl set-default "$id"
  signal_waybar
}

status() {
  local cur class text label tooltip laptop_id headset_id
  cur=$(current_name || true)
  laptop_id=$(find_node_id laptop || true)
  headset_id=$(find_node_id headset || true)

  case "$cur" in
    bluez_input.*)
      class="headset"
      text=" "
      label="headset"
      ;;
    alsa_input.*)
      class="laptop"
      text=" "
      label="laptop"
      ;;
    "")
      class="unknown"
      text=" ?"
      label="unknown"
      ;;
    *)
      class="unknown"
      text=" ?"
      label="$cur"
      ;;
  esac

  tooltip="Mic: $label"
  [[ -n "$cur" ]] && tooltip="$tooltip\nCurrent: $cur"
  [[ -n "$laptop_id" ]] && tooltip="$tooltip\nLaptop mic id: $laptop_id"
  [[ -n "$headset_id" ]] && tooltip="$tooltip\nHeadset mic id: $headset_id"
  tooltip="$tooltip\nClick to toggle"

  printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' \
    "$text" "$class" "$(printf '%s' "$tooltip" | json_escape)"
}

toggle() {
  case "$(current_name || true)" in
    bluez_input.*) set_source laptop ;;
    *) set_source headset ;;
  esac
}

case "${1:-status}" in
  status|--status) status ;;
  toggle|--toggle) toggle ;;
  laptop|--laptop) set_source laptop ;;
  headset|--headset) set_source headset ;;
  *)
    printf 'Usage: %s [status|toggle|laptop|headset]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
