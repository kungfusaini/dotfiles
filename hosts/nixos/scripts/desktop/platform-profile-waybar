#!/usr/bin/env bash

profile_file=/sys/firmware/acpi/platform_profile
choices_file=/sys/firmware/acpi/platform_profile_choices

if [[ ! -r "$profile_file" ]]; then
  printf '{"text":"profile ?","tooltip":"ACPI platform profile unavailable","class":"unknown"}\n'
  exit 0
fi

profile=$(cat "$profile_file" 2>/dev/null)
choices=$(cat "$choices_file" 2>/dev/null || true)

tooltip="Platform profile: $profile"
if [[ -n "$choices" ]]; then
  tooltip="$tooltip\\nChoices: $choices"
fi

case "$profile" in
  low-power)
    printf '{"text":"󰌪","tooltip":"%s","class":"low-power"}\n' "$tooltip"
    ;;
  balanced)
    printf '{"text":"󰾅","tooltip":"%s","class":"balanced"}\n' "$tooltip"
    ;;
  performance)
    printf '{"text":"󰓅","tooltip":"%s","class":"performance"}\n' "$tooltip"
    ;;
  *)
    printf '{"text":"Profile %s","tooltip":"%s","class":"unknown"}\n' "$profile" "$tooltip"
    ;;
esac
